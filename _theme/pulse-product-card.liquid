{%- doc -%}
  Pulse product card (used on the home page segment rows and the category pages).
  The feature row shows the model's brochure icons (product metafield pulse.badges);
  products without them fall back to their tags.

  @param {object} product - The product to render.
  @param {string} [phone] - Call number with country code, no + or spaces.
  @param {string} [whatsapp] - WhatsApp number with country code, no + or spaces.
{%- enddoc -%}
{%- assign ppc_variant = product.selected_or_first_available_variant -%}
{%- assign ppc_phone = phone | default: '919071101108' -%}
{%- assign ppc_wa = whatsapp | default: ppc_phone -%}
{%- assign ppc_wa_text = 'Hi, I am interested in the ' | append: product.title -%}
{%- liquid
  # Card has room for 4 icons. When a model has 5 brochure icons, leave out "Top Speed" (6 km/h on every Pulse chair).
  assign ppc_badges = product.metafields.pulse.badges.value
  assign ppc_list = ''
  if ppc_badges != blank
    if ppc_badges.size > 4
      for b in ppc_badges
        unless b contains 'Top Speed'
          assign ppc_list = ppc_list | append: b | append: '|~|'
        endunless
      endfor
    else
      assign ppc_list = ppc_badges | join: '|~|'
    endif
  else
    assign ppc_list = product.tags | join: '|~|'
  endif
  assign ppc_items = ppc_list | split: '|~|'
-%}
<div class="pulse-card">
  <a href="{{ product.url }}" style="text-decoration:none;color:inherit;">
    <div class="pulse-card__image{%- assign ppc_ext = product.featured_image.src | split: '?' | first | split: '.' | last | downcase -%}{% if product.type == 'Accessories' or ppc_ext == 'jpg' or ppc_ext == 'jpeg' %} pulse-card__image--fill{% endif %}">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="600" height="600">
      {% endif %}
    </div>
    {%- assign ppc_model = product.metafields.pulse.model_name.value -%}
    {%- if ppc_model != blank -%}
    <span class="pulse-card__eyebrow">{{ product.title }}</span>
    <h3 class="pulse-card__title">{{ ppc_model }}</h3>
    {%- else -%}
    {%- if product.type != blank -%}<span class="pulse-card__eyebrow">{{ product.type }}</span>{%- endif -%}
    <h3 class="pulse-card__title">{{ product.title }}</h3>
    {%- endif -%}
    <p class="pulse-card__desc">{{ product.description | split: '===SPECIFICATIONS===' | first | strip_html | truncate: 140 }}</p>
  </a>

  {% if ppc_items.size > 0 %}
    <ul class="pulse-card__tags" role="list" aria-label="Key features">
      {% for tag in ppc_items limit: 4 %}
        <li class="pulse-card__tag">
          <span class="pulse-card__tag-icon" aria-hidden="true">{% render 'pulse-badge-icon', label: tag %}</span>
          <span class="pulse-card__tag-label">{{ tag }}</span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  <div>
    {% form 'product', product, data-pulse-atc: '' %}
      <input type="hidden" name="id" value="{{ ppc_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <div class="pulse-card__footer-row">
        <div class="pulse-card__price-wrap">
          <span class="pulse-card__price">
            <span class="pulse-card__cur">₹</span>{{ product.price | money_without_currency | remove: '.00' }}
            {%- if product.compare_at_price > product.price -%}
              <s class="pulse-card__mrp">₹{{ product.compare_at_price | money_without_currency | remove: '.00' }}</s>
            {%- endif -%}
          </span>
          <span class="pulse-card__perk">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h14v12H1zM15 9h4l3 3v4h-7"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="18.5" cy="18.5" r="2"/></svg>
            Free delivery
          </span>
        </div>
        <div class="pulse-card__icon-group">
          <a href="tel:+{{ ppc_phone }}" class="pulse-card__icon-btn" aria-label="Call a Pulse expert" title="Call a Pulse expert">
            <svg class="pulse-ico pulse-ico--call" viewBox="0 0 1074.000000 1074.000000" fill="currentColor" aria-hidden="true"><use href="#pulse-ico-call"/></svg>
          </a>
          <a href="https://wa.me/{{ ppc_wa }}?text={{ ppc_wa_text | url_encode }}" target="_blank" rel="noopener" class="pulse-card__icon-btn pulse-card__icon-btn--wa" aria-label="Chat on WhatsApp about the {{ product.title | escape }}" title="Chat on WhatsApp">
            <svg class="pulse-ico pulse-ico--wa" viewBox="0 0 572.000000 572.000000" fill="currentColor" aria-hidden="true"><use href="#pulse-ico-wa"/></svg>
          </a>
          {% if product.available %}
            <button type="submit" name="add" class="pulse-card__icon-btn" aria-label="Add to cart" title="Add to cart">
              <svg class="pulse-ico pulse-ico--bag" viewBox="0 0 1074.000000 1074.000000" fill="currentColor" aria-hidden="true"><use href="#pulse-ico-bag"/></svg>
            </button>
          {% endif %}
        </div>
      </div>
      {% if product.available %}
        <a href="{% unless customer %}/account/login?checkout_url={% endunless %}/cart/{{ ppc_variant.id }}:1" class="pulse-card__buy-btn" rel="nofollow" style="text-decoration:none">
          <span>Buy Now</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      {% else %}
        <button type="button" class="pulse-card__buy-btn" disabled style="opacity:.55;cursor:not-allowed"><span>Sold out</span></button>
      {% endif %}
    {% endform %}
  </div>
</div>
