{%- comment -%} Pulse: one blog post card. Params: article, eager {%- endcomment -%}
{%- liquid
  assign pbc_words = article.content | strip_html | split: ' ' | size
  assign pbc_mins = pbc_words | divided_by: 200 | plus: 1
  assign pbc_text = article.excerpt | default: article.content | strip_html | truncatewords: 32
  assign pbc_tag = ''
  for t in article.tags
    unless t == 'Electric wheelchair'
      assign pbc_tag = t
      break
    endunless
  endfor
-%}
<a class="pb-card" href="{{ article.url }}">
  {%- render 'pulse-blog-art', article: article, size: 'md', eager: eager -%}
  <div class="pb-card__body">
    <div class="pb-meta">
      {%- if pbc_tag != blank -%}<span class="pb-chip pb-chip--org">{{ pbc_tag }}</span>{%- endif -%}
      <span>{{ article.published_at | date: '%d %b %Y' }}</span>
      <span>· {{ pbc_mins }} min read</span>
    </div>
    <h3 class="pb-card__title">{{ article.title }}</h3>
    <p class="pb-card__text">{{ pbc_text }}</p>
    <span class="pb-card__more">Read guide<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
  </div>
</a>
