{%- comment -%}
  Pulse: "Helpful guides" on product pages. Links each chair to its category and to the 3 blog posts that
  best match it (lightweight/travel chairs → flights; heavy-duty → lightweight vs heavy-duty; recliners → elderly care),
  so shoppers find answers and Google sees how the pages connect. Posts that don't exist are skipped.
{%- endcomment -%}
{%- liquid
  assign h = product.handle
  assign pg_posts = 'how-to-choose-electric-wheelchair-india,electric-wheelchair-price-india,electric-wheelchair-battery-care-guide'
  if h contains 'heavyduty' or h contains 'dualdrive'
    assign pg_posts = 'lightweight-vs-heavy-duty-electric-wheelchair,best-electric-wheelchair-for-elderly-india,electric-wheelchair-battery-care-guide'
  elsif h contains 'homecare'
    assign pg_posts = 'best-electric-wheelchair-for-elderly-india,lightweight-vs-heavy-duty-electric-wheelchair,rent-or-buy-electric-wheelchair'
  elsif h contains 'premium-comfort' or h contains 'comfortride'
    assign pg_posts = 'best-electric-wheelchair-for-elderly-india,electric-wheelchair-on-flight-india-rules,electric-wheelchair-battery-care-guide'
  elsif h contains 'travelmate' or h contains 'ultralight' or h contains 'minilite' or h contains 'slimfold'
    assign pg_posts = 'electric-wheelchair-on-flight-india-rules,lightweight-vs-heavy-duty-electric-wheelchair,best-electric-wheelchair-for-elderly-india'
  elsif h contains 'everyday' or h contains 'smartfold'
    assign pg_posts = 'best-electric-wheelchair-for-elderly-india,electric-wheelchair-on-flight-india-rules,electric-vs-manual-wheelchair'
  elsif h contains 'battery'
    assign pg_posts = 'electric-wheelchair-battery-care-guide,electric-wheelchair-on-flight-india-rules,how-to-choose-electric-wheelchair-india'
  endif
  assign pg_posts = pg_posts | split: ','

  assign pg_cat = blank
  for c in product.collections
    if c.handle contains 'segment' or c.handle == 'accessories'
      assign pg_cat = c
      break
    endif
  endfor
-%}
<style>
  .ppg{max-width:1100px;margin:3rem auto 0;padding:0 1.5rem;font-family:var(--pulse-font-sans,system-ui,sans-serif)}
  .ppg__h{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.5rem 1rem;margin-bottom:1rem}
  .ppg__k{display:inline-flex;align-items:center;gap:.6rem;font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#EE8B1B}
  .ppg__k:before{content:'';width:28px;height:1.5px;background:currentColor}
  .ppg h2{margin:.35rem 0 0;font-size:clamp(1.3rem,2.2vw,1.7rem);color:#0F1E36;letter-spacing:-.02em;font-weight:700}
  .ppg__cat{font-size:.95rem;font-weight:600;color:#1B355E;text-decoration:none;border-bottom:1.5px solid rgba(238,139,27,.6);padding-bottom:2px}
  .ppg__cat:hover{color:#EE8B1B}
  .ppg__g{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}
  .ppg__c{display:flex;flex-direction:column;gap:.5rem;padding:1.2rem 1.25rem;border-radius:20px;background:#fff;border:1px solid #E4E9F0;text-decoration:none;color:#4A5870;transition:transform .2s,box-shadow .2s,border-color .2s}
  .ppg__c:hover{transform:translateY(-3px);border-color:rgba(238,139,27,.5);box-shadow:0 24px 40px -30px rgba(15,30,54,.45)}
  .ppg__t{font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#8090A6}
  .ppg__c b{font-size:1.02rem;line-height:1.35;color:#0F1E36}
  .ppg__c p{margin:0;font-size:.9rem;line-height:1.55;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .ppg__go{margin-top:auto;font-size:.88rem;font-weight:700;color:#EE8B1B}
  @media (max-width:749px){.ppg{padding:0 1rem;margin-top:2.25rem}.ppg__g{grid-template-columns:1fr;gap:.75rem}.ppg__c{padding:1rem 1.1rem;border-radius:16px}}
</style>
<section class="ppg" aria-labelledby="ppg-h">
  <div class="ppg__h">
    <div><span class="ppg__k">{{ section.settings.kicker }}</span><h2 id="ppg-h">{{ section.settings.heading }}</h2></div>
    {%- if pg_cat != blank -%}<a class="ppg__cat" href="{{ pg_cat.url }}">Compare all {{ pg_cat.title | remove: ' Segment' | downcase }} {% if pg_cat.handle == 'accessories' %}parts{% else %}wheelchairs{% endif %} →</a>{%- endif -%}
  </div>
  <div class="ppg__g">
    {%- for ph in pg_posts -%}
      {%- assign pg_key = 'news/' | append: ph -%}
      {%- assign a = articles[pg_key] -%}
      {%- if a != blank and a.title != blank -%}
      <a class="ppg__c" href="{{ a.url }}">
        <span class="ppg__t">Guide · {{ a.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} min read</span>
        <b>{{ a.title }}</b>
        <p>{{ a.excerpt | default: a.content | strip_html | truncate: 150 }}</p>
        <span class="ppg__go">Read the guide →</span>
      </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Pulse helpful guides",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Helpful guides" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you decide" }
  ],
  "presets": [{ "name": "Pulse helpful guides" }]
}
{% endschema %}
