{%- comment -%}
  Pulse: while the "Mega Diwali Sale" announcement is showing, the top bar fades from navy to festive orange.
  Works with the rotating announcement bar above it (any announcement whose text contains "Diwali").
  Outputs no visible content of its own.
{%- endcomment -%}
<style>
  /* host = the announcement bar's section; an orange layer fades in over the navy while the Diwali message shows */
  .pab-host{position:relative;isolation:isolate;}
  .pab-host:before{content:'';position:absolute;inset:0;z-index:0;pointer-events:none;opacity:0;transition:opacity .6s ease;background:linear-gradient(90deg,#C2410C 0%,#F2921F 30%,#FFB347 50%,#F2921F 70%,#C2410C 100%);}
  .pab-host.pab-diwali:before{opacity:1;}
  .pab-host > .announcement-bar{position:relative;z-index:1;}
  .pab-diwali .announcement-bar__slider .announcement-bar__text{color:#fff!important;}
  .pab-diwali .announcement-bar__slider .announcement-bar__text strong{background:linear-gradient(90deg,#FFFFFF 0%,#FFFFFF 35%,#FFF1C9 50%,#FFFFFF 65%,#FFFFFF 100%);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;}
  .pab-diwali .announcement-bar__slider .announcement-bar__text:before{background:linear-gradient(90deg,transparent,#fff);}
  .pab-diwali .announcement-bar__slider .announcement-bar__text:after{background:linear-gradient(90deg,#fff,transparent);}
  .shopify-section:has(> .pulse-ann-diwali){display:none;}
</style>
<div class='pulse-ann-diwali' hidden></div>
<script>
  (function () {
    function run() {
      var slider = document.querySelector('.announcement-bar__slider');
      if (!slider) return;
      var host = slider.closest('.shopify-section') || slider.parentElement;
      host.classList.add('pab-host');
      function sync() {
        var cur = slider.querySelector(".announcement-bar__slide[aria-hidden='false']");
        host.classList.toggle('pab-diwali', !!cur && /diwali/i.test(cur.textContent || ''));
      }
      sync();
      new MutationObserver(sync).observe(slider, { subtree: true, attributes: true, attributeFilter: ['aria-hidden'] });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
  })();
</script>

{% schema %}
{
  "name": "Pulse Diwali bar colour",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "paragraph", "content": "Turns the announcement bar orange while an announcement containing the word \"Diwali\" is showing. Remove this section (or the Diwali announcement) after the sale." }
  ],
  "presets": [{ "name": "Pulse Diwali bar colour" }]
}
{% endschema %}
