{%- comment -%}
  Pulse: a buying guide under the products on category pages (who the range is for, which model to pick,
  a comparison table and links to guides). Content comes from the collection metafield pulse.guide (HTML),
  so it can be edited per category in Shopify admin: Products → Collections → (category) → Metafields.
  Nothing is shown for categories without a guide.
{%- endcomment -%}
{%- assign pcg_html = collection.metafields.pulse.guide.value -%}
{%- if pcg_html != blank -%}
<style>
  .pcg{max-width:1100px;margin:3.5rem auto 0;padding:0 1.5rem;font-family:var(--pulse-font-sans,system-ui,sans-serif);color:#4A5870}
  .pcg__card{padding:2.25rem 2.5rem;border-radius:26px;background:#fff;border:1px solid #E4E9F0;box-shadow:0 30px 60px -40px rgba(15,30,54,.35)}
  .pcg__k{display:inline-flex;align-items:center;gap:.6rem;font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#EE8B1B}
  .pcg__k:before{content:'';width:28px;height:1.5px;background:currentColor}
  .pcg h2{margin:.55rem 0 .9rem;font-size:clamp(1.35rem,2.4vw,1.85rem);line-height:1.25;letter-spacing:-.02em;color:#0F1E36;font-weight:700}
  .pcg h3{margin:1.8rem 0 .7rem;font-size:1.12rem;color:#0F1E36;font-weight:700}
  .pcg p,.pcg li{font-size:1rem;line-height:1.75}
  .pcg p{margin:0 0 1rem}
  .pcg ul{margin:0 0 1rem;padding-left:1.15rem}
  .pcg li{margin:.35rem 0}
  .pcg li::marker{color:#EE8B1B}
  .pcg strong{color:#0F1E36}
  .pcg a{color:#1B355E;font-weight:600;text-decoration:underline;text-decoration-color:rgba(238,139,27,.55);text-underline-offset:3px}
  .pcg a:hover{color:#EE8B1B}
  .pcg__tw{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:.4rem 0 .4rem;border:1px solid #E4E9F0;border-radius:16px}
  .pcg table{width:100%;min-width:640px;border-collapse:collapse;font-size:.93rem}
  .pcg th{background:#F5F7FA;color:#0F1E36;text-align:left;font-weight:700;padding:.75rem .9rem;white-space:nowrap}
  .pcg td{padding:.72rem .9rem;border-top:1px solid #EEF1F5;vertical-align:top}
  .pcg td:first-child a{text-decoration:none;white-space:nowrap}
  .pcg td:nth-child(5){white-space:nowrap;color:#0F1E36;font-weight:600}
  .pcg__fn{font-size:.8rem!important;color:#8090A6;margin-top:.4rem!important}
  @media (max-width:749px){.pcg{margin-top:2.5rem;padding:0 1rem}.pcg__card{padding:1.5rem 1.2rem;border-radius:20px}.pcg p,.pcg li{font-size:.95rem}}
</style>
<section class="pcg" aria-label="{{ collection.title | escape }} buying guide">
  <div class="pcg__card">
    <span class="pcg__k">{{ section.settings.kicker }}</span>
    {{ pcg_html }}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Pulse category guide",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label above the heading", "default": "Buying guide" }
  ],
  "presets": [{ "name": "Pulse category guide" }]
}
{% endschema %}
