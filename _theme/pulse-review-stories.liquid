{%- comment -%}
  Pulse: swipeable carousel of customer review images (portrait 9:16) under the reviews.
  Images come from the product's "Review stories" field (pulse.review_stories). Hidden when empty.
  Tap an image to see it full size, with an Order now button.
{%- endcomment -%}
{%- assign prs = product.metafields.pulse.review_stories.value -%}
{%- if prs != blank and prs.size > 0 -%}
{% style %}
  .prs{--navy:#1B355E;--ink:#0F1E36;--mut:#5B6B82;--org:#F2921F;max-width:1240px;margin:0 auto 3.5rem;padding:0 24px;font-family:var(--pulse-font-sans,system-ui,sans-serif);color:var(--ink);}
  .prs *{box-sizing:border-box;}
  .prs__head{position:relative;text-align:center;max-width:720px;margin:0 auto 26px;}
  .prs__eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:11.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--org);margin:0 0 8px;}
  .prs__eyebrow:before{content:'';width:24px;height:1.5px;background:currentColor;}
  .prs__h{font-size:clamp(26px,3vw,38px);font-weight:700;letter-spacing:-.02em;line-height:1.15;margin:0;}
  .prs__h span{color:var(--org);}
  .prs__sub{margin:10px auto 0;max-width:560px;font-size:clamp(14.5px,1.4vw,16.5px);line-height:1.55;color:var(--mut);}
  .prs__wrap{position:relative;}
  .prs__nav{display:flex;justify-content:center;gap:10px;margin:6px 0 0;}
  .prs .prs__arr{display:grid;place-items:center;width:44px;height:44px;min-height:0;padding:0;margin:0;border:1px solid #DCE3EE;border-radius:50%;background:#fff;color:var(--navy);font-size:22px;line-height:1;cursor:pointer;box-shadow:0 8px 18px -12px rgba(15,30,54,.5);transition:background .2s,color .2s,opacity .2s;}
  .prs .prs__arr:hover{background:var(--navy);color:#fff;}
  .prs .prs__arr[disabled]{opacity:.35;cursor:default;background:#fff;color:var(--navy);}
  .prs__track{display:grid;grid-auto-flow:column;grid-auto-columns:clamp(240px,24%,300px);gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:4px 2px 18px;scrollbar-width:none;-webkit-overflow-scrolling:touch;}
  .prs__track::-webkit-scrollbar{display:none;}
  .prs.fits .prs__track{justify-content:center;}
  .prs.fits .prs__nav,.prs.fits .prs__dots{display:none;}
  .prs__card{position:relative;scroll-snap-align:start;aspect-ratio:9/16;border-radius:20px;overflow:hidden;background:#EEF3F9;box-shadow:0 22px 40px -28px rgba(15,30,54,.6);cursor:zoom-in;transition:transform .25s ease,box-shadow .25s ease;}
  .prs__card:hover{transform:translateY(-3px);box-shadow:0 28px 48px -26px rgba(15,30,54,.7);}
  .prs__card img{width:100%;height:100%;object-fit:cover;display:block;}
  .prs .prs__card{padding:0;margin:0;border:0;min-height:0;}
  .prs__dots{display:flex;justify-content:center;gap:8px;margin-top:4px;}
  .prs__dot{width:8px;height:8px;border-radius:999px;background:#D3DCE8;transition:width .25s,background .25s;}
  .prs__dot.on{width:22px;background:var(--org);}
  .prs__lb{position:fixed;inset:0;z-index:2147483000;display:none;align-items:center;justify-content:center;flex-direction:column;gap:14px;padding:16px;background:rgba(15,30,54,.88);}
  .prs__lb.open{display:flex;}
  .prs__lb img{max-width:min(440px,92vw);max-height:calc(100vh - 120px);border-radius:18px;object-fit:contain;}
  .prs__lb-x{position:absolute;top:14px;right:14px;width:42px;height:42px;border:0;border-radius:50%;background:#fff;color:var(--ink);font-size:22px;line-height:1;cursor:pointer;}
  .prs__lb-buy{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 28px;border:0;border-radius:14px;background:linear-gradient(180deg,#F7A640,#F2921F);color:var(--ink);font:700 15px var(--pulse-font-sans,system-ui,sans-serif);cursor:pointer;}
  @media (max-width:749px){.prs{padding:0 16px;}.prs__nav{display:none;}.prs__track{grid-auto-columns:72%;gap:12px;}}
{% endstyle %}

<section class="prs" id="prs-{{ section.id }}" aria-label="Customer stories">
  <div class="prs__head">
    {%- if section.settings.eyebrow != blank -%}<p class="prs__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="prs__h">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="prs__sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="prs__track" data-prs-track>
    {%- for img in prs -%}
      {%- assign im = img.image | default: img -%}
      <button type="button" class="prs__card" data-prs-full="{{ im | image_url: width: 1200 }}" aria-label="View customer story {{ forloop.index }} full size">
        {{ im | image_url: width: 700 | image_tag: loading: 'lazy', alt: img.alt, widths: '360,540,700', sizes: '(max-width: 749px) 72vw, 300px' }}
      </button>
    {%- endfor -%}
  </div>
  {%- if prs.size > 1 -%}
  <div class="prs__dots" aria-hidden="true">{%- for img in prs -%}<span class="prs__dot{% if forloop.first %} on{% endif %}"></span>{%- endfor -%}</div>
  {%- endif -%}
  {%- if prs.size > 1 -%}
    <div class="prs__nav">
      <button type="button" class="prs__arr" data-prs-prev aria-label="Previous story">‹</button>
      <button type="button" class="prs__arr" data-prs-next aria-label="Next story">›</button>
    </div>
    {%- endif -%}
  <div class="prs__lb" data-prs-lb role="dialog" aria-modal="true" aria-label="Customer story">
    <button type="button" class="prs__lb-x" data-prs-close aria-label="Close">×</button>
    <img alt="" data-prs-img>
    <button type="button" class="prs__lb-buy" data-prs-buy>Order now →</button>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('prs-{{ section.id }}'); if (!root) return;
  var track = root.querySelector('[data-prs-track]'), cards = track.children, dots = root.querySelectorAll('.prs__dot');
  var prev = root.querySelector('[data-prs-prev]'), next = root.querySelector('[data-prs-next]');
  function step() { return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth; }
  function update() {
    var i = Math.round(track.scrollLeft / Math.max(1, step()));
    dots.forEach(function (d, di) { d.classList.toggle('on', di === Math.min(i, dots.length - 1)); });
    var end = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    if (prev) prev.disabled = track.scrollLeft <= 4;
    if (next) next.disabled = end;
    root.classList.toggle('fits', track.scrollWidth <= track.clientWidth + 4);
  }
  if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
  track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
  window.addEventListener('resize', update); update();

  var lb = root.querySelector('[data-prs-lb]'), lbImg = root.querySelector('[data-prs-img]');
  document.body.appendChild(lb);
  function close() { lb.classList.remove('open'); document.documentElement.style.overflow = ''; }
  track.addEventListener('click', function (e) {
    var c = e.target.closest('[data-prs-full]'); if (!c) return;
    var im = c.querySelector('img'); lbImg.src = c.dataset.prsFull; lbImg.alt = im ? im.alt : '';
    lb.classList.add('open'); document.documentElement.style.overflow = 'hidden';
  });
  lb.addEventListener('click', function (e) { if (e.target === lb || e.target.closest('[data-prs-close]')) close(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && lb.classList.contains('open')) close(); });
  lb.querySelector('[data-prs-buy]').addEventListener('click', function () {
    close();
    var top = document.querySelector('.ad-top') || document.getElementById('MainContent');
    if (top) top.scrollIntoView({ behavior: 'smooth', block: 'start' }); else window.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Pulse Review Stories",
  "settings": [
    { "type": "paragraph", "content": "Shows the product's \"Review stories\" images (Products → product → Metafields → Review stories). Portrait 9:16 images work best. Hidden on products without any." },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading (optional)", "default": "" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Happy <span>Customers</span>" },
    { "type": "text", "id": "subheading", "label": "Line below heading", "default": "Real families across India who chose Pulse for more freedom, comfort and independence every day." }
  ],
  "presets": [{ "name": "Pulse Review Stories" }]
}
{% endschema %}
