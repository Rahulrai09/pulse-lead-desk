{%- render 'pulse-blog-styles' -%}
{%- liquid
  assign pa_phone = section.settings.phone_number | default: '919071101108'
  assign pa_words = article.content | strip_html | split: ' ' | size
  assign pa_mins = pa_words | divided_by: 200 | plus: 1
  assign pa_intro = article.excerpt | strip_html | strip
  assign pa_url = request.origin | append: article.url
  assign pa_tag = ''
  for t in article.tags
    unless t == 'Electric wheelchair'
      assign pa_tag = t
      break
    endunless
  endfor
  assign pa_updated = article.updated_at | date: '%Y-%m-%d'
  assign pa_published = article.published_at | date: '%Y-%m-%d'
-%}
<style>
  .pa-hero{padding:2.75rem 0 3.25rem;}
  .pa-hero__in{max-width:860px;}
  .pa-hero h1{margin:.9rem 0 1rem;font-size:clamp(1.9rem,4.2vw,3rem);font-weight:700;letter-spacing:-.025em;line-height:1.1;color:#fff;}
  .pa-hero__intro{margin:0 0 1.4rem;font-size:1.08rem;line-height:1.65;color:rgba(255,255,255,.8);max-width:720px;}
  .pa-hero .pb-meta{color:rgba(255,255,255,.7);}
  .pa-author{display:inline-flex;align-items:center;gap:.55rem;color:#fff;font-weight:600;}
  .pa-author i{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#fff;font-style:normal;}
  .pa-author i img{width:20px;height:20px;object-fit:contain;}
  .pa-cover{max-width:1100px;margin:-1.75rem auto 0;padding:0 1.5rem;position:relative;z-index:2;}
  .pa-cover .pba{aspect-ratio:16/7;border-radius:24px;box-shadow:0 40px 80px -40px rgba(15,30,54,.55);}
  .pa-main{padding:3rem 0 4rem;background:linear-gradient(180deg,#F7FAFF 0%,#FFFFFF 340px);}
  .pa-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:3.5rem;align-items:start;max-width:1120px;margin:0 auto;}
  .pa-side{position:sticky;top:110px;display:flex;flex-direction:column;gap:1.1rem;}
  .pa-toc{padding:1.3rem 1.3rem 1.1rem;border-radius:20px;background:#fff;border:1px solid #E4E9F0;box-shadow:0 24px 50px -40px rgba(15,30,54,.4);}
  .pa-toc__t{margin:0 0 .7rem;font-size:.7rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#5B6B82;}
  .pa-toc summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:.5rem;}
  .pa-toc summary::-webkit-details-marker{display:none;}
  .pa-toc summary svg{width:16px;height:16px;transition:transform .25s;}
  .pa-toc[open] summary svg{transform:rotate(180deg);}
  .pa-toc:not([open]) .pa-toc__t{margin:0;}
  @media (min-width:990px){.pa-toc summary{pointer-events:none;}.pa-toc summary svg{display:none;}}
  .pa-toc ol{list-style:none;margin:0;padding:0;counter-reset:toc;display:flex;flex-direction:column;gap:.15rem;}
  .pa-toc li{counter-increment:toc;}
  .pa-toc a{display:flex;gap:.6rem;padding:.42rem .5rem;border-radius:10px;font-size:.86rem;line-height:1.4;color:#33415A;text-decoration:none;transition:background .2s,color .2s;}
  .pa-toc a:before{content:counter(toc,decimal-leading-zero);flex-shrink:0;font-size:.72rem;font-weight:700;color:#9AA6B8;padding-top:.1rem;}
  .pa-toc a:hover{background:#F5F7FA;color:#1B355E;}
  .pa-toc a.is-on{background:#FFF1E2;color:#0F1E36;font-weight:600;}
  .pa-toc a.is-on:before{color:#C96F0C;}
  .pa-ask{position:relative;overflow:hidden;isolation:isolate;padding:1.4rem;border-radius:20px;color:#fff;background:radial-gradient(120% 140% at 100% 0%,#2E5591 0%,#1B355E 50%,#0F1E36 100%);}
  .pa-ask:before{content:'';position:absolute;z-index:-1;width:180px;height:180px;right:-70px;top:-70px;border-radius:50%;border:1.5px solid rgba(238,139,27,.5);}
  .pa-ask b{display:block;font-size:1.05rem;margin-bottom:.35rem;}
  .pa-ask p{margin:0 0 1rem;font-size:.86rem;line-height:1.55;color:rgba(255,255,255,.75);}
  .pa-ask .pb-btn{height:42px;font-size:.85rem;padding:0 1.1rem;width:100%;justify-content:center;}

  /* Article typography */
  .pa-prose{font-size:1.06rem;line-height:1.8;color:#2B3A52;min-width:0;}
  .pa-prose > *:first-child{margin-top:0;}
  .pa-prose p{margin:0 0 1.15rem;}
  .pa-prose > p:first-child{position:relative;padding:1.3rem 1.5rem 1.3rem 1.6rem;border-radius:18px;background:linear-gradient(135deg,#FFF6EC 0%,#FFFFFF 100%);border:1px solid #FBE3C7;font-size:1.08rem;line-height:1.7;color:#0F1E36;}
  .pa-prose > p:first-child:before{content:'';position:absolute;left:0;top:18px;bottom:18px;width:4px;border-radius:0 4px 4px 0;background:#EE8B1B;}
  .pa-prose h2{position:relative;margin:2.8rem 0 1rem;padding-top:1.2rem;font-size:clamp(1.4rem,2.4vw,1.75rem);font-weight:700;line-height:1.25;letter-spacing:-.02em;color:#0F1E36;scroll-margin-top:110px;}
  .pa-prose h2:before{content:'';position:absolute;left:0;top:0;width:44px;height:3px;border-radius:3px;background:linear-gradient(90deg,#F6A94B,#EE8B1B);}
  .pa-prose h3{margin:1.8rem 0 .6rem;font-size:1.15rem;font-weight:700;line-height:1.35;color:#0F1E36;scroll-margin-top:110px;}
  .pa-prose strong{color:#0F1E36;}
  .pa-prose a{color:#1B355E;font-weight:600;text-decoration:underline;text-decoration-color:rgba(238,139,27,.6);text-decoration-thickness:2px;text-underline-offset:3px;transition:color .2s;}
  .pa-prose a:hover{color:#C96F0C;}
  .pa-prose ul,.pa-prose ol{margin:0 0 1.3rem;padding:0;list-style:none;display:flex;flex-direction:column;gap:.6rem;}
  .pa-prose ul li{position:relative;padding-left:1.6rem;}
  .pa-prose ul li:before{content:'';position:absolute;left:.25rem;top:.72em;width:8px;height:8px;border-radius:50%;background:#EE8B1B;box-shadow:0 0 0 4px #FFF1E2;}
  .pa-prose ol{counter-reset:pa;}
  .pa-prose ol li{position:relative;padding-left:2.4rem;counter-increment:pa;}
  .pa-prose ol li:before{content:counter(pa);position:absolute;left:0;top:.15em;display:grid;place-items:center;width:1.65rem;height:1.65rem;border-radius:50%;background:#1B355E;color:#fff;font-size:.8rem;font-weight:700;line-height:1;}
  .pa-prose em{color:#5B6B82;}
  .pa-prose img{max-width:100%;height:auto;border-radius:16px;}
  .pa-prose table{display:block;width:100%;overflow-x:auto;border-collapse:separate;border-spacing:0;margin:1.5rem 0 1.8rem;font-size:.92rem;line-height:1.5;border:1px solid #E4E9F0;border-radius:16px;-webkit-overflow-scrolling:touch;}
  .pa-prose th,.pa-prose td{padding:.75rem .95rem;text-align:left;vertical-align:top;border-bottom:1px solid #E4E9F0;min-width:120px;}
  .pa-prose thead th{background:#1B355E;color:#fff;font-weight:700;white-space:nowrap;}
  .pa-prose thead th:first-child{border-top-left-radius:15px;}
  .pa-prose thead th:last-child{border-top-right-radius:15px;}
  .pa-prose tbody tr:nth-child(even) td{background:#F7F9FC;}
  .pa-prose tbody tr:last-child td{border-bottom:0;}
  .pa-prose td:first-child{font-weight:600;color:#0F1E36;}

  .pa-foot{margin-top:2.5rem;padding-top:1.6rem;border-top:1px solid #E4E9F0;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;}
  .pa-tags{display:flex;flex-wrap:wrap;gap:.45rem;}
  .pa-tags a{background:#F2F5FA;color:#1B355E;}
  .pa-tags a:hover{background:#1B355E;color:#fff;}
  .pa-share{display:flex;align-items:center;gap:.5rem;font-size:.85rem;color:#5B6B82;}
  .pa-share a,.pa-share button{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;border:1px solid #E4E9F0;background:#fff;color:#1B355E;cursor:pointer;transition:all .2s;}
  .pa-share a:hover,.pa-share button:hover{background:#1B355E;border-color:#1B355E;color:#fff;}
  .pa-share svg{width:17px;height:17px;}
  .pa-share button.is-done{background:#0B7A57;border-color:#0B7A57;color:#fff;}
  .pa-more{padding:3.5rem 0 4.5rem;background:linear-gradient(180deg,#FFF5EC 0%,#FFFFFF 100%);}
  .pa-more__head{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:1.5rem;}
  .pa-more__head h2{margin:.5rem 0 0;font-size:clamp(1.4rem,2.6vw,1.9rem);font-weight:700;letter-spacing:-.02em;color:#0F1E36;}
  .pa-more__head a{font-size:.9rem;font-weight:700;color:#1B355E;text-decoration:none;}
  .pa-more__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem;margin-bottom:3rem;}

  @media (max-width:989px){
    .pa-grid{grid-template-columns:1fr;gap:0;}
    .pa-side{position:static;order:-1;margin-bottom:1.75rem;}
    .pa-side .pa-ask{display:none;}
    .pa-more__grid{grid-template-columns:repeat(2,minmax(0,1fr));}
  }
  @media (max-width:640px){
    .pa-hero{padding:2rem 0 2.5rem;}
    .pa-hero__intro{font-size:.98rem;}
    .pa-cover{padding:0 1.1rem;margin-top:-1.25rem;}
    .pa-cover .pba{aspect-ratio:16/9;border-radius:18px;}
    .pa-main{padding:2rem 0 3rem;}
    .pa-prose{font-size:1rem;line-height:1.75;}
    .pa-prose > p:first-child{padding:1.1rem 1.1rem 1.1rem 1.3rem;font-size:1rem;}
    .pa-toc{padding:1.1rem;}
    .pa-more__grid{grid-template-columns:1fr;}
  }
</style>

<article class="pb">
  <header class="pb-hero pa-hero">
    <div class="pb-wrap">
      <div class="pa-hero__in">
        <nav class="pb-crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="{{ blog.url }}">Guides</a>{% if pa_tag != blank %}<span>/</span><a href="{{ blog.url }}/tagged/{{ pa_tag | handleize }}">{{ pa_tag }}</a>{% endif %}</nav>
        {%- if pa_tag != blank -%}<span class="pb-chip pb-chip--org">{{ pa_tag }}</span>{%- endif -%}
        <h1>{{ article.title }}</h1>
        {%- if pa_intro != blank -%}<p class="pa-hero__intro">{{ pa_intro }}</p>{%- endif -%}
        <div class="pb-meta">
          <span class="pa-author"><i><img src="{{ 'pulse-favicon.png' | asset_url }}" alt="" width="20" height="20"></i>{{ article.author | default: 'Pulse Mobility Team' }}</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg><time datetime="{{ pa_published }}">{{ article.published_at | date: '%d %B %Y' }}</time></span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{{ pa_mins }} min read</span>
        </div>
      </div>
    </div>
  </header>

  {%- if article.image -%}
    <div class="pa-cover">{%- render 'pulse-blog-art', article: article, size: 'lg', eager: true -%}</div>
  {%- endif -%}

  <div class="pa-main">
    <div class="pb-wrap">
      <div class="pa-grid">
        <div>
          <div class="pa-prose" data-pa-prose>{{ article.content }}</div>
          <div class="pa-foot">
            <div class="pa-tags">
              {%- for t in article.tags -%}<a class="pb-chip" href="{{ blog.url }}/tagged/{{ t | handleize }}">{{ t }}</a>{%- endfor -%}
            </div>
            <div class="pa-share">Share
              <a href="https://wa.me/?text={{ article.title | append: ' ' | append: pa_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp">{% render 'pulse-wa-icon' %}</a>
              <a href="https://www.facebook.com/sharer/sharer.php?u={{ pa_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 8.5V6.8c0-.8.5-1 1-1h2V2.2L14.2 2C11.3 2 10.6 4.2 10.6 5.6v2.9H8.4V12h2.2v10H14V12h2.8l.4-3.5z"/></svg></a>
              <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ pa_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.1c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4z"/></svg></a>
              <button type="button" data-pa-copy="{{ pa_url }}" aria-label="Copy link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg></button>
            </div>
          </div>
        </div>
        <aside class="pa-side">
          <details class="pa-toc" data-pa-toc hidden open>
            <summary class="pa-toc__t">In this guide<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></summary>
            <ol></ol>
          </details>
          <div class="pa-ask">
            <b>Talk to a Pulse expert</b>
            <p>Free advice on the right wheelchair for your weight, home and travel.</p>
            <a class="pb-btn pb-btn--org" href="https://wa.me/{{ pa_phone }}?text={{ 'Hi, I read your guide "' | append: article.title | append: '" and have a question.' | url_encode }}" target="_blank" rel="noopener">{% render 'pulse-wa-icon' %}WhatsApp us</a>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <section class="pa-more">
    <div class="pb-wrap">
      {%- assign pa_more_count = 0 -%}
      {%- capture pa_more -%}
        {%- for other in blog.articles -%}
          {%- if other.id == article.id -%}{%- continue -%}{%- endif -%}
          {%- if pa_more_count >= 3 -%}{%- break -%}{%- endif -%}
          {%- assign pa_more_count = pa_more_count | plus: 1 -%}
          {%- render 'pulse-blog-card', article: other, eager: false -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if pa_more_count > 0 -%}
        <div class="pa-more__head">
          <div><span class="pb-eyebrow">Keep reading</span><h2>More guides from Pulse</h2></div>
          <a href="{{ blog.url }}">All guides →</a>
        </div>
        <div class="pa-more__grid">{{ pa_more }}</div>
      {%- endif -%}
      <div class="pb-help">
        <div>
          <h2>{{ section.settings.help_heading }}</h2>
          <p>{{ section.settings.help_text }}</p>
        </div>
        <div class="pb-help__btns">
          <a class="pb-btn pb-btn--org" href="https://wa.me/{{ pa_phone }}?text={{ 'Hi, I need help choosing a Pulse wheelchair.' | url_encode }}" target="_blank" rel="noopener">{% render 'pulse-wa-icon' %}WhatsApp an expert</a>
          <a class="pb-btn pb-btn--glass" href="/collections/wheelchair">Browse wheelchairs</a>
        </div>
      </div>
    </div>
  </section>
</article>

<script>
  (function () {
    var prose = document.querySelector('[data-pa-prose]');
    var toc = document.querySelector('[data-pa-toc]');
    if (prose && toc) {
      var hs = prose.querySelectorAll('h2');
      if (hs.length >= 3) {
        var ol = toc.querySelector('ol'), links = [];
        hs.forEach(function (h, i) {
          if (!h.id) h.id = (h.textContent || 'section').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60) || 'section-' + i;
          var li = document.createElement('li'), a = document.createElement('a');
          a.href = '#' + h.id; a.textContent = h.textContent.replace(/^\d+\.\s*/, '');
          li.appendChild(a); ol.appendChild(li); links.push(a);
        });
        toc.hidden = false;
        if (window.innerWidth < 990) toc.open = false;
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (e) {
              if (!e.isIntersecting) return;
              var i = Array.prototype.indexOf.call(hs, e.target);
              links.forEach(function (l, j) { l.classList.toggle('is-on', j === i); });
            });
          }, { rootMargin: '-15% 0px -70% 0px' });
          hs.forEach(function (h) { io.observe(h); });
        }
      }
    }
    var cp = document.querySelector('[data-pa-copy]');
    if (cp) cp.addEventListener('click', function () {
      var u = cp.getAttribute('data-pa-copy');
      (navigator.clipboard ? navigator.clipboard.writeText(u) : Promise.reject()).then(function () {
        cp.classList.add('is-done'); setTimeout(function () { cp.classList.remove('is-done'); }, 1600);
      }).catch(function () { window.prompt('Copy this link:', u); });
    });
  })();
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": {{ pa_url | append: '#article' | json }},
  "mainEntityOfPage": {{ pa_url | json }},
  "headline": {{ article.title | json }},
  "description": {{ pa_intro | default: article.title | json }},
  {%- if article.image %}
  "image": [{{ article.image | image_url: width: 1600 | prepend: 'https:' | json }}],
  {%- endif %}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "wordCount": {{ pa_words }},
  "inLanguage": "en-IN",
  "keywords": {{ article.tags | join: ', ' | json }},
  "author": { "@type": "Organization", "name": {{ article.author | default: 'Pulse Mobility Team' | json }}, "url": {{ request.origin | append: '/' | json }} },
  "publisher": { "@id": {{ request.origin | append: '/#organization' | json }} }
}
</script>

{% schema %}
{
  "name": "Pulse blog post",
  "settings": [
    { "type": "text", "id": "help_heading", "label": "Help band heading", "default": "Not sure which wheelchair is right?" },
    { "type": "text", "id": "help_text", "label": "Help band text", "default": "Tell a Pulse mobility expert the user's weight, home and how they'll travel. Free advice, no pressure." },
    { "type": "text", "id": "phone_number", "label": "WhatsApp number (with country code, no + or spaces)", "default": "919071101108" }
  ]
}
{% endschema %}
