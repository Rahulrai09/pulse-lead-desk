{%- assign pf_phone = section.settings.phone_number | default: '919071101108' -%}
{%- assign pf_wa = section.settings.whatsapp_number | default: pf_phone -%}
{% style %}
  .pulse-footer{background:radial-gradient(120% 140% at 100% 0%,#24467A 0%,#1B355E 40%,#0F1E36 100%);color:#fff;padding:0 1.5rem 1.75rem;font-family:var(--pulse-font-sans,Inter,system-ui,sans-serif);-webkit-font-smoothing:antialiased;}
  .pulse-footer *{box-sizing:border-box;}
  .pulse-footer__inner{max-width:1280px;margin:0 auto;}
  .pulse-footer__help{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.25rem;padding:2.25rem 0;border-bottom:1px solid rgba(255,255,255,.12);}
  .pulse-footer__help-title{font-size:1.4rem;font-weight:700;letter-spacing:-.01em;margin:0;}
  .pulse-footer__help-text{font-size:.9rem;color:rgba(255,255,255,.7);margin:.35rem 0 0;}
  .pulse-footer__help-btns{display:flex;flex-wrap:wrap;gap:.75rem;}
  .pulse-footer__btn{display:inline-flex;align-items:center;gap:.55rem;height:46px;padding:0 1.3rem;border-radius:999px;font-size:.9rem;font-weight:700;text-decoration:none;transition:all .2s;}
  .pulse-footer__btn svg{width:18px;height:18px;flex-shrink:0;}
  .pulse-footer__btn--solid{background:#fff;color:#1B355E;}
  .pulse-footer__btn--solid:hover{background:#EE8B1B;color:#fff;}
  .pulse-footer__btn--line{border:1px solid rgba(255,255,255,.35);color:#fff;}
  .pulse-footer__btn--line:hover{border-color:#fff;background:rgba(255,255,255,.08);}
  .pulse-footer__grid{display:grid;grid-template-columns:1fr;gap:2.5rem;padding:3rem 0 2.5rem;}
  @media (min-width:750px){.pulse-footer__grid{grid-template-columns:1fr 1fr 1fr;}.pulse-footer__brand{grid-column:1 / -1;}}
  @media (min-width:990px){.pulse-footer__grid{grid-template-columns:1.7fr 1fr 1fr 1fr;gap:2.5rem;}.pulse-footer__brand{grid-column:auto;}}
  .pulse-footer__logo{display:inline-flex;align-items:center;margin:0 0 .35rem;font-size:1.6rem;font-weight:700;letter-spacing:.05em;color:#fff;}
  .pulse-footer__logo img{height:30px;width:auto;display:block;}
  .pulse-footer__logo-accent{color:#EE8B1B;}
  .pulse-footer__tagline{font-size:.7rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#EE8B1B;margin:.5rem 0 1rem;}
  .pulse-footer__desc{font-size:.9rem;line-height:1.65;color:rgba(255,255,255,.72);max-width:400px;margin:0 0 1.75rem;}
  .pulse-footer__newsletter-label{font-size:.95rem;font-weight:700;margin:0 0 .3rem;}
  .pulse-footer__newsletter-sub{font-size:.8rem;color:rgba(255,255,255,.6);margin:0 0 .9rem;}
  .pulse-footer__newsletter-form{display:flex;max-width:400px;padding:5px;border-radius:999px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);transition:border-color .2s;}
  .pulse-footer__newsletter-form:focus-within{border-color:rgba(255,255,255,.5);}
  .pulse-footer .pulse-footer__newsletter-form input[type="email"]{flex:1;min-width:0;background:transparent;border:0;outline:0;box-shadow:none;padding:0 .9rem;color:#fff;font-size:.88rem;height:40px;}
  .pulse-footer__newsletter-form input[type="email"]::placeholder{color:rgba(255,255,255,.45);}
  .pulse-footer .pulse-footer__newsletter-form button{background:#EE8B1B;color:#fff;border:0;border-radius:999px;height:40px;min-height:0;padding:0 1.3rem;font-weight:700;font-size:.85rem;cursor:pointer;transition:background .2s;}
  .pulse-footer .pulse-footer__newsletter-form button:hover{background:#d97b15;}
  .pulse-footer__col-title{font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.5);margin:0 0 1.1rem;}
  .pulse-footer__links{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.8rem;}
  .pulse-footer__links a{color:rgba(255,255,255,.85);text-decoration:none;font-size:.92rem;transition:color .2s,padding .2s;}
  .pulse-footer__links a:hover{color:#EE8B1B;padding-left:3px;}
  .pulse-footer__bottom{border-top:1px solid rgba(255,255,255,.12);padding-top:1.5rem;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;}
  .pulse-footer__copyright{font-size:.8rem;color:rgba(255,255,255,.55);margin:0;}
  .pulse-footer__socials{display:flex;gap:.6rem;}
  .pulse-footer__socials a{display:inline-grid;place-items:center;width:36px;height:36px;border-radius:50%;border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.8);transition:all .2s;}
  .pulse-footer__socials a:hover{color:#fff;border-color:#EE8B1B;background:#EE8B1B;}
  .pulse-footer__socials svg{height:16px;width:16px;}
  .pf-short{display:none}
  @media (max-width:749px){
    .pulse-footer__help{padding:1.6rem 0;gap:1rem}
    .pulse-footer__help-title{font-size:1.1rem;line-height:1.3}
    .pulse-footer__help-text{font-size:.8rem}
    .pulse-footer__help-btns{flex-wrap:nowrap;width:100%;gap:.6rem}
    .pulse-footer__btn{flex:1 1 0;min-width:0;justify-content:center;height:44px;padding:0 .75rem;font-size:.85rem;white-space:nowrap}
    .pulse-footer__btn svg{width:16px;height:16px}
    .pf-long{display:none}
    .pf-short{display:inline}
    .pulse-footer__grid{grid-template-columns:1fr 1fr;gap:2.25rem 1.25rem}
    .pulse-footer__brand{grid-column:1 / -1}
  }
  /* Map + address under the brand text (tap opens Google Maps at Pulse Medical Equipment Manufacturer) */
  .pulse-footer__map{position:relative;display:block;max-width:400px;height:170px;margin:0 0 1rem;border-radius:14px;overflow:hidden;border:1px solid rgba(255,255,255,.18);box-shadow:0 18px 36px -24px rgba(0,0,0,.8);background:#E9EEF5;}
  .pulse-footer__map iframe{position:absolute;inset:0;width:100%;height:100%;border:0;pointer-events:none;}
  .pulse-footer__map-link{position:absolute;inset:0;z-index:1;display:flex;align-items:flex-end;justify-content:flex-end;padding:10px;text-decoration:none;}
  .pulse-footer__map-cta{display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:999px;background:#1B355E;color:#fff;font-size:.78rem;font-weight:700;box-shadow:0 6px 16px -6px rgba(0,0,0,.6);transition:background .2s;}
  .pulse-footer__map-link:hover .pulse-footer__map-cta{background:#EE8B1B;}
  .pulse-footer__map-cta svg{width:14px;height:14px;}
  .pulse-footer__addr{display:flex;gap:.6rem;max-width:400px;margin:0 0 1.75rem;color:rgba(255,255,255,.8);font-size:.88rem;line-height:1.55;text-decoration:none;}
  .pulse-footer__addr:hover{color:#EE8B1B;}
  .pulse-footer__addr svg{flex:0 0 18px;width:18px;height:18px;margin-top:2px;color:#EE8B1B;}
{% endstyle %}

<footer class="pulse-footer">
  <div class="pulse-footer__inner">
    {%- if section.settings.show_help -%}
      <div class="pulse-footer__help">
        <div>
          <p class="pulse-footer__help-title">{{ section.settings.help_heading }}</p>
          <p class="pulse-footer__help-text">{{ section.settings.help_text }}</p>
        </div>
        <div class="pulse-footer__help-btns">
          <a class="pulse-footer__btn pulse-footer__btn--solid" href="tel:+{{ pf_phone }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg><span class="pf-long">Call {{ section.settings.phone_label }}</span><span class="pf-short">Call us</span></a>
          <a class="pulse-footer__btn pulse-footer__btn--line" href="https://wa.me/{{ pf_wa }}" target="_blank" rel="noopener">{% render 'pulse-wa-icon' %}WhatsApp us</a>
        </div>
      </div>
    {%- endif -%}

    <div class="pulse-footer__grid">
      <div class="pulse-footer__brand">
        <a class="pulse-footer__logo" href="/">
          {% if section.settings.logo_image != blank %}
            <img src="{{ section.settings.logo_image | image_url: width: 200 }}" alt="{{ shop.name }}" width="200" height="50" loading="lazy">
          {% else %}
            PULS<span class="pulse-footer__logo-accent">E</span>
          {% endif %}
        </a>
        <p class="pulse-footer__tagline">{{ section.settings.tagline }}</p>
        <p class="pulse-footer__desc">{{ section.settings.description }}</p>
        {%- liquid
          assign pf_addr = '1st Floor, Plot No. 646, 27th Main Road, Sector 1, HSR Layout, Bengaluru, Karnataka - 560102'
          assign pf_place = 'Pulse Medical Equipment Manufacturer, 646, 27th Main Road, HSR Layout, Bengaluru 560102'
          assign pf_q = pf_place | url_encode
        -%}
        <div class="pulse-footer__map">
          <iframe src="https://maps.google.com/maps?q={{ pf_q }}&z=16&output=embed" title="Pulse location on Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade" tabindex="-1" aria-hidden="true"></iframe>
          <a class="pulse-footer__map-link" href="https://www.google.com/maps/search/?api=1&query={{ pf_q }}" target="_blank" rel="noopener" aria-label="Open Pulse on Google Maps for directions">
            <span class="pulse-footer__map-cta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l19-9-9 19-2-8-8-2z"/></svg>Get directions</span>
          </a>
        </div>
        <a class="pulse-footer__addr" href="https://www.google.com/maps/search/?api=1&query={{ pf_q }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          <span>{{ pf_addr }}</span>
        </a>

        {%- if section.settings.show_newsletter -%}
        <p class="pulse-footer__newsletter-label">{{ section.settings.newsletter_heading }}</p>
        <p class="pulse-footer__newsletter-sub">{{ section.settings.newsletter_subtext }}</p>
        {% form 'customer', class: 'pulse-footer__newsletter-form' %}
          {% if form.posted_successfully? %}
            <p style="font-size:0.85rem;color:#EE8B1B;margin:0;padding:.6rem .9rem;">Thanks for subscribing!</p>
          {% else %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="email" name="contact[email]" placeholder="Your email address" aria-label="Email address" required>
            <button type="submit">Subscribe</button>
          {% endif %}
        {% endform %}
        {%- endif -%}
      </div>

      {%- if section.settings.shop_menu.links.size > 0 -%}
        <div>
          <p class="pulse-footer__col-title">{{ section.settings.shop_title }}</p>
          <ul class="pulse-footer__links">
            {% for link in section.settings.shop_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
          </ul>
        </div>
      {%- endif -%}

      <div>
        <p class="pulse-footer__col-title">{{ section.settings.company_title }}</p>
        <ul class="pulse-footer__links">
          {% for link in section.settings.company_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
        </ul>
      </div>

      <div>
        <p class="pulse-footer__col-title">{{ section.settings.support_title }}</p>
        <ul class="pulse-footer__links">
          {% for link in section.settings.support_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
        </ul>
      </div>
    </div>

    <div class="pulse-footer__bottom">
      <p class="pulse-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: shop.name }}. All rights reserved.</p>
      <div class="pulse-footer__socials">
        {% if section.settings.facebook_url != blank %}
          <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.5 9.9v-7H7.9V12h2.6V9.8c0-2.6 1.5-4 3.9-4 1.1 0 2.3.2 2.3.2v2.5h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.9l-.5 2.9h-2.4v7A10 10 0 0 0 22 12z"/></svg></a>
        {% endif %}
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg></a>
        {% endif %}
        {% if section.settings.youtube_url != blank %}
          <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9l5 3-5 3V9z" fill="currentColor" stroke="none"/></svg></a>
        {% endif %}
        {% if section.settings.linkedin_url != blank %}
          <a href="{{ section.settings.linkedin_url }}" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm6 0h3.8v1.7h.05c.53-1 1.83-2 3.77-2 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.97V21H9V9z"/></svg></a>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pulse Footer",
  "settings": [
    { "type": "checkbox", "id": "show_help", "label": "Show 'Need help choosing?' band", "default": true },
    { "type": "text", "id": "help_heading", "label": "Help band heading", "default": "Need help choosing the right wheelchair?" },
    { "type": "text", "id": "help_text", "label": "Help band text", "default": "Talk to a Pulse mobility expert. Free advice, no pressure." },
    { "type": "text", "id": "phone_number", "label": "Call number (with country code, no + or spaces)", "default": "919071101108" },
    { "type": "text", "id": "phone_label", "label": "Call number as shown to customers", "default": "+91 90711 01108" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (with country code, no + or spaces)", "default": "919071101108" },

    { "type": "image_picker", "id": "logo_image", "label": "White logo image (optional, leave blank to use text logo)" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "MOBILITY & CARE" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Mobility solutions engineered for everyday independence. Certified, lightweight, and foldable — because freedom should never weigh you down." },

    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter sign-up", "default": false },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join our newsletter" },
    { "type": "text", "id": "newsletter_subtext", "label": "Newsletter subtext", "default": "Tips, new arrivals, and exclusive deals — straight to your inbox." },

    { "type": "text", "id": "shop_title", "label": "Shop column title", "default": "Shop" },
    { "type": "link_list", "id": "shop_menu", "label": "Shop column menu" },

    { "type": "text", "id": "company_title", "label": "Company column title", "default": "Company" },
    { "type": "link_list", "id": "company_menu", "label": "Company column menu (create this under Online Store > Navigation)" },

    { "type": "text", "id": "support_title", "label": "Support column title", "default": "Support" },
    { "type": "link_list", "id": "support_menu", "label": "Support column menu (create this under Online Store > Navigation)" },

    { "type": "text", "id": "copyright_name", "label": "Copyright name", "default": "Pulse Wheelchairs" },

    { "type": "url", "id": "facebook_url", "label": "Facebook URL (leave blank to hide)" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL (leave blank to hide)" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL (leave blank to hide)" },
    { "type": "url", "id": "linkedin_url", "label": "LinkedIn URL (leave blank to hide)" }
  ],
  "presets": [{ "name": "Pulse Footer" }]
}
{% endschema %}
