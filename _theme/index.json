    "faq_home": {
      "type": "pulse-faq",
      "settings": {
        "source": "blocks",
        "eyebrow": "FAQs",
        "heading": "Questions about Pulse wheelchairs",
        "intro": "Quick answers about range, weight, travel, delivery and warranty.",
        "soft": true,
        "show_cta": true
      },
      "blocks": {
        "q_01": {
          "type": "faq",
          "settings": {
            "question": "Which Pulse wheelchair is right for me?",
            "answer": "It depends on the user's weight, home and travel. For the lightest chair, see the UltraLight or MiniLite (19 kg). For flights, choose an IATA-compliant model like the Everyday or SmartFold. For users up to 140 kg, see the Heavy Duty range. Or WhatsApp us on +91 90711 01108 for free advice."
          }
        },
        "q_02": {
          "type": "faq",
          "settings": {
            "question": "How far can a Pulse wheelchair go on one charge?",
            "answer": "Every Pulse electric wheelchair is rated for up to 15 km per charge, at a top speed of 6 km/h. Real range depends on the user's weight, the road surface and slopes."
          }
        },
        "q_03": {
          "type": "faq",
          "settings": {
            "question": "What are the frames made of?",
            "answer": "Most models have a light aluminium frame. Our heavy-duty models and the SlimFold use a sturdy steel frame. The carbon-fibre look on some chairs is a hydro-dipped colour finish, not carbon fibre."
          }
        },
        "q_04": {
          "type": "faq",
          "settings": {
            "question": "How much weight can they carry?",
            "answer": "Most models support users up to 120 kg. The HeavyDuty, DualDrive and HomeCare Recliner support up to 140 kg."
          }
        },
        "q_05": {
          "type": "faq",
          "settings": {
            "question": "Can I take a Pulse wheelchair on a flight?",
            "answer": "Most of our lightweight models are IATA compliant. Each airline makes its own final decision on mobility devices, so please check with your airline before you fly."
          }
        },
        "q_06": {
          "type": "faq",
          "settings": {
            "question": "Is delivery free?",
            "answer": "Yes, delivery is free across India and usually takes 3–5 business days."
          }
        },
        "q_07": {
          "type": "faq",
          "settings": {
            "question": "What warranty do I get?",
            "answer": "Every Pulse wheelchair comes with a 1-year warranty against manufacturing defects. See our Warranty Policy for details."
          }
        },
        "q_08": {
          "type": "faq",
          "settings": {
            "question": "Can I pay in EMI?",
            "answer": "Yes, EMI is available on select credit and debit cards. You'll see the EMI options for your card at checkout."
          }
        }
      },
