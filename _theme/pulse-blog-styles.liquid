{%- comment -%} Pulse: shared styles for the blog list and blog post pages. {%- endcomment -%}
{{ 'pulse-custom.css' | asset_url | stylesheet_tag }}
<style>
  .pb{--navy:#1B355E;--ink:#0F1E36;--muted:#5B6B82;--line:#E4E9F0;--org:#EE8B1B;--org-d:#C96F0C;--soft:#F5F7FA;
    font-family:var(--pulse-font-sans,system-ui,sans-serif);color:var(--ink);-webkit-font-smoothing:antialiased;overflow-x:clip;background:#fff;}
  .pb *{box-sizing:border-box;}
  .pb a{color:inherit;}
  .pb-wrap{max-width:1200px;margin:0 auto;padding:0 1.5rem;}

  /* Navy hero band (same look as the category pages) */
  .pb-hero{position:relative;isolation:isolate;overflow:hidden;color:#fff;background:radial-gradient(120% 140% at 100% 0%,#2E5591 0%,#1B355E 45%,#0F1E36 100%);}
  .pb-hero:before{content:'';position:absolute;z-index:-1;width:520px;height:520px;right:-160px;top:-220px;border-radius:50%;border:1.5px solid rgba(238,139,27,.35);}
  .pb-hero:after{content:'';position:absolute;z-index:-1;width:300px;height:300px;right:-40px;top:-100px;border-radius:50%;border:1.5px dashed rgba(255,255,255,.14);}
  .pb-crumb{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;font-size:12.5px;color:rgba(255,255,255,.62);margin:0 0 1.4rem;}
  .pb-crumb a{text-decoration:none;}.pb-crumb a:hover{color:#fff;}
  .pb-eyebrow{display:inline-flex;align-items:center;gap:.6rem;font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--org);}
  .pb-eyebrow:before{content:'';width:28px;height:1.5px;background:currentColor;}
  .pb-chip{display:inline-flex;align-items:center;height:28px;padding:0 .8rem;border-radius:999px;font-size:.72rem;font-weight:700;letter-spacing:.02em;text-decoration:none;white-space:nowrap;}
  .pb-chip--org{background:#FFF1E2;color:var(--org-d);}
  .pb-chip--glass{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.22);}
  .pb-meta{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem .9rem;font-size:.82rem;color:var(--muted);}
  .pb-meta span{display:inline-flex;align-items:center;gap:.35rem;}
  .pb-meta svg{width:14px;height:14px;opacity:.8;}

  /* Cover art (image or branded gradient) */
  .pba{position:relative;overflow:hidden;isolation:isolate;aspect-ratio:16/10;border-radius:18px;background:linear-gradient(150deg,#2C5391 0%,#1B355E 55%,#0F1E36 100%);}
  .pba--travel{background:linear-gradient(150deg,#3A6FB8 0%,#1B355E 60%,#0F1E36 100%);}
  .pba--battery{background:linear-gradient(150deg,#2B6A6E 0%,#1B355E 60%,#0F1E36 100%);}
  .pba--compare{background:linear-gradient(150deg,#5A4A8F 0%,#1B355E 60%,#0F1E36 100%);}
  .pba__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:transform .7s cubic-bezier(.2,.7,.2,1);}
  .pba__ring{position:absolute;border-radius:50%;z-index:-1;}
  .pba__ring--1{width:70%;aspect-ratio:1;right:-18%;top:-30%;border:1.5px solid rgba(238,139,27,.55);}
  .pba__ring--2{width:46%;aspect-ratio:1;left:-12%;bottom:-24%;background:radial-gradient(circle,rgba(143,179,232,.35),rgba(143,179,232,0) 70%);}
  .pba__grid{position:absolute;z-index:-1;left:7%;top:12%;width:120px;height:80px;background-image:radial-gradient(rgba(255,255,255,.5) 1.2px,transparent 1.4px);background-size:14px 14px;opacity:.35;}
  .pba__icon{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:grid;place-items:center;width:28%;max-width:120px;aspect-ratio:1;border-radius:28%;color:#fff;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.22);box-shadow:0 20px 40px -20px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.2);backdrop-filter:blur(6px);transition:transform .5s cubic-bezier(.2,.7,.2,1);}
  .pba__icon svg{width:46%;height:46%;}
  .pba__icon:after{content:'';position:absolute;right:-5px;top:-5px;width:16px;height:16px;border-radius:50%;background:var(--org);border:3px solid #1B355E;}

  /* Post cards */
  .pb-card{position:relative;display:flex;flex-direction:column;gap:1rem;padding:12px 12px 22px;border-radius:24px;background:#fff;border:1px solid var(--line);box-shadow:0 30px 60px -40px rgba(15,30,54,.35);text-decoration:none;transition:transform .45s cubic-bezier(.2,.7,.2,1),box-shadow .45s,border-color .3s;}
  .pb-card:hover{transform:translateY(-6px);border-color:#D5DEEA;box-shadow:0 36px 70px -34px rgba(15,30,54,.45);}
  .pb-card:hover .pba__img{transform:scale(1.04);}
  .pb-card:hover .pba__icon{transform:translate(-50%,-50%) scale(1.06) rotate(-3deg);}
  .pb-card__body{display:flex;flex-direction:column;gap:.7rem;padding:0 .6rem;flex:1;}
  .pb-card__title{margin:0;font-size:1.2rem;font-weight:700;line-height:1.3;letter-spacing:-.015em;color:var(--ink);}
  .pb-card__text{margin:0;font-size:.92rem;line-height:1.6;color:var(--muted);display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;}
  .pb-card__more{margin-top:auto;display:inline-flex;align-items:center;gap:.4rem;font-size:.88rem;font-weight:700;color:var(--navy);}
  .pb-card__more svg{width:16px;height:16px;transition:transform .3s;}
  .pb-card:hover .pb-card__more{color:var(--org-d);}
  .pb-card:hover .pb-card__more svg{transform:translateX(4px);}

  /* Expert help band */
  .pb-help{position:relative;overflow:hidden;isolation:isolate;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem;padding:2.25rem 2.5rem;border-radius:28px;color:#fff;background:radial-gradient(120% 140% at 100% 0%,#2E5591 0%,#1B355E 45%,#0F1E36 100%);}
  .pb-help:before{content:'';position:absolute;z-index:-1;width:300px;height:300px;right:-90px;bottom:-160px;border-radius:50%;border:1.5px solid rgba(238,139,27,.45);}
  .pb-help h2{margin:0 0 .4rem;font-size:clamp(1.35rem,2.4vw,1.8rem);font-weight:700;letter-spacing:-.02em;color:#fff;}
  .pb-help p{margin:0;color:rgba(255,255,255,.75);font-size:.98rem;line-height:1.6;max-width:520px;}
  .pb-help__btns{display:flex;flex-wrap:wrap;gap:.75rem;}
  .pb-btn{display:inline-flex;align-items:center;gap:.55rem;height:48px;padding:0 1.4rem;border-radius:999px;font-weight:700;font-size:.92rem;text-decoration:none;transition:all .25s;}
  .pb-btn svg{width:18px;height:18px;}
  .pb-btn--org{background:linear-gradient(180deg,#F7A640,#EE8B1B);color:#0F1E36;box-shadow:0 12px 24px -12px rgba(238,139,27,.9);}
  .pb-btn--org:hover{filter:brightness(1.05);transform:translateY(-1px);}
  .pb-btn--glass{border:1.5px solid rgba(255,255,255,.35);color:#fff;}
  .pb-btn--glass:hover{background:#fff;color:var(--navy);}
  .pb-btn--navy{background:linear-gradient(180deg,#24467A,#1B355E);color:#fff;box-shadow:0 10px 20px -12px rgba(27,53,94,.8);}
  .pb-btn--navy:hover{background:var(--org);}

  @media (max-width:749px){
    .pb-wrap{padding:0 1.1rem;}
    .pb-help{padding:1.75rem 1.4rem;border-radius:22px;}
    .pb-btn{height:46px;font-size:.88rem;}
  }
</style>
