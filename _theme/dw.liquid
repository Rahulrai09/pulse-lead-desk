{%- doc -%}
  Pulse Diwali scratch card (product page, in place of the EMI line).
  Tap the banner -> a card flips open in a pop-up -> scratch the gold foil -> ₹3,000 OFF.
  The saving is real: it applies discount code DIWALI3000 (₹3,000 off each wheelchair, set up in Shopify Discounts).
  Once scratched, the page shows the Diwali price and remembers it on this device.

  @param {object} product - The product on the page.
  @param {object} variant - The selected variant (for Buy Now).
  @param {string} id - Unique id (section.id).
{%- enddoc -%}
{%- assign pdw_code = 'DIWALI3000' -%}
{%- assign pdw_off = 300000 -%}
{%- assign pdw_new = product.price | minus: pdw_off -%}
{%- assign pdw_name = product.metafields.pulse.model_name.value | default: product.title -%}
<style>
  .pdw,.pdw-ov{--pdw-a:#5A0F1E;--pdw-b:#B3261E;--pdw-g:#F6B73C;--pdw-g2:#FFD978;font-family:inherit;}
  .pdw-ov *{box-sizing:border-box;}
  .pdw *{box-sizing:border-box;}
  .pdw .pdw-bar{all:unset;box-sizing:border-box;position:relative;overflow:hidden;margin-top:16px;display:flex;align-items:center;gap:12px;width:100%;padding:12px 14px;border-radius:14px;cursor:pointer;color:#fff;background:linear-gradient(110deg,var(--pdw-a) 0%,var(--pdw-b) 55%,#E0661B 100%);box-shadow:0 10px 24px -14px rgba(179,38,30,.9);font-size:13.5px;font-weight:700;line-height:1.25;-webkit-tap-highlight-color:transparent;}
  .pdw .pdw-bar:after{content:'';position:absolute;inset:0;background:linear-gradient(100deg,transparent 30%,rgba(255,236,180,.45) 50%,transparent 70%);transform:translateX(-120%);animation:pdwShine 3.2s ease-in-out infinite;pointer-events:none;}
  .pdw .pdw-bar:focus-visible{outline:2px solid var(--pdw-g);outline-offset:2px;}
  .pdw-diya{flex:0 0 auto;width:30px;height:30px;display:grid;place-items:center;border-radius:10px;background:rgba(255,217,120,.18);}
  .pdw-diya svg{width:22px;height:22px;display:block;}
  .pdw-txt{flex:1 1 auto;min-width:0;}
  .pdw-txt small{display:block;font-size:11px;font-weight:600;opacity:.85;letter-spacing:.02em;margin-top:2px;}
  .pdw-pill{flex:0 0 auto;padding:7px 12px;border-radius:999px;background:linear-gradient(180deg,var(--pdw-g2),var(--pdw-g));color:#5A0F1E;font-size:12px;font-weight:800;white-space:nowrap;}
  .pdw.done .pdw-bar{background:linear-gradient(110deg,#0B5E3F,#0E8A5A);box-shadow:0 10px 24px -14px rgba(14,138,90,.9);}
  .pdw.done .pdw-bar:after{animation:none;}
  .pdw.done .pdw-pill{background:#fff;color:#0B5E3F;}
  @keyframes pdwShine{0%,55%{transform:translateX(-120%);}100%{transform:translateX(120%);}}

  .pdw-ov{position:fixed;inset:0;z-index:2147483100;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(20,6,10,.72);backdrop-filter:blur(3px);}
  .pdw-ov.open{display:flex;animation:pdwFade .25s ease;}
  @keyframes pdwFade{from{opacity:0}to{opacity:1}}
  .pdw-x{all:unset;position:absolute;top:14px;right:14px;width:40px;height:40px;border-radius:50%;background:#fff;color:#2A0A12;display:grid;place-items:center;font-size:22px;line-height:1;cursor:pointer;z-index:3;}
  .pdw-scene{perspective:1400px;width:min(340px,92vw);height:min(460px,82vh);}
  .pdw-card{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .9s cubic-bezier(.2,.8,.2,1);}
  .pdw-ov.flip .pdw-card{transform:rotateY(180deg);}
  .pdw-face{position:absolute;inset:0;border-radius:24px;overflow:hidden;backface-visibility:hidden;-webkit-backface-visibility:hidden;box-shadow:0 30px 60px -20px rgba(0,0,0,.7);}
  .pdw-front{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center;color:#FFE7B0;padding:28px;background:radial-gradient(70% 50% at 50% 38%,rgba(255,200,90,.35),transparent 70%),repeating-conic-gradient(from 0deg at 50% 38%,rgba(255,215,120,.08) 0 6deg,transparent 6deg 18deg),linear-gradient(165deg,#3B0812,#7A1424 55%,#3B0812);}
  .pdw-front h3{margin:0;font-size:30px;font-weight:800;letter-spacing:-.01em;color:#FFD978;text-shadow:0 2px 14px rgba(255,170,40,.5);}
  .pdw-front p{margin:0;font-size:14px;opacity:.9;}
  .pdw-front .pdw-big{width:96px;height:96px;}
  .pdw-back{transform:rotateY(180deg);background:linear-gradient(170deg,#FFF7E6,#FFE9C2);color:#3B0812;display:flex;flex-direction:column;align-items:center;text-align:center;padding:22px 20px 20px;}
  .pdw-back .pdw-k{font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#B3261E;}
  .pdw-back h4{margin:6px 0 14px;font-size:19px;font-weight:800;line-height:1.2;}
  .pdw-zone{position:relative;width:100%;height:170px;border-radius:18px;overflow:hidden;background:linear-gradient(160deg,#fff,#FFF3D6);border:2px dashed rgba(179,38,30,.35);touch-action:none;}
  .pdw-prize{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;}
  .pdw-prize b{font-size:40px;font-weight:900;color:#B3261E;letter-spacing:-.02em;line-height:1;}
  .pdw-prize span{font-size:13px;font-weight:700;color:#5A0F1E;}
  .pdw-zone canvas{position:absolute;inset:0;width:100%;height:100%;cursor:grab;transition:opacity .5s ease;}
  .pdw-zone.clear canvas{opacity:0;pointer-events:none;}
  .pdw-hint{margin-top:10px;font-size:12px;font-weight:600;color:#7A4A2A;}
  .pdw-res{display:none;width:100%;margin-top:12px;}
  .pdw-ov.won .pdw-res{display:block;animation:pdwFade .4s ease;}
  .pdw-ov.won .pdw-hint{display:none;}
  .pdw-np{font-size:13px;font-weight:600;color:#5A0F1E;}
  .pdw-np b{font-size:22px;font-weight:900;color:#0B5E3F;margin-left:4px;}
  .pdw-np s{margin-left:6px;color:#8A6A5A;font-weight:600;}
  .pdw-code{margin:6px 0 12px;font-size:11.5px;color:#7A4A2A;}
  .pdw-code code{font-weight:800;color:#3B0812;background:#fff;border:1px dashed #E0A040;border-radius:6px;padding:2px 6px;}
  .pdw-go{all:unset;box-sizing:border-box;display:flex;align-items:center;justify-content:center;width:100%;height:48px;border-radius:14px;cursor:pointer;font-size:15px;font-weight:800;color:#3B0812;background:linear-gradient(180deg,var(--pdw-g2),var(--pdw-g));box-shadow:0 10px 22px -12px rgba(224,150,40,.9);}
  .pdw-later{all:unset;display:block;margin:10px auto 0;font-size:12.5px;font-weight:700;color:#7A4A2A;cursor:pointer;text-decoration:underline;}
  .pdw-spark{position:absolute;width:8px;height:8px;border-radius:50%;pointer-events:none;animation:pdwBurst 1.1s ease-out forwards;}
  @keyframes pdwBurst{from{transform:translate(0,0) scale(1);opacity:1}to{transform:translate(var(--dx),var(--dy)) scale(.3);opacity:0}}
  .ad-price b.pdw-was{display:none;}
  .pdw-diwali-tag{background:#FDECEA;color:#B3261E;font-size:12px;font-weight:800;padding:5px 10px;border-radius:999px;}
  @media (prefers-reduced-motion:reduce){.pdw-card{transition:none}.pdw .pdw-bar:after{animation:none}}
</style>

<div class='pdw' id='pdw-{{ id }}' data-code='{{ pdw_code }}' data-off='{{ pdw_off }}' data-price='{{ product.price }}' data-compare='{{ product.compare_at_price | default: 0 }}' data-variant='{{ variant.id }}'>
  <button type='button' class='pdw-bar' aria-haspopup='dialog'>
    <span class='pdw-diya' aria-hidden='true'><svg viewBox='0 0 24 24'><path d='M12 2.5c1.8 2.4 2.6 4.1 2.6 5.4a2.6 2.6 0 0 1-5.2 0c0-1.3.8-3 2.6-5.4z' fill='#FFD978'/><path d='M2.5 13h19c-.6 4.4-4.6 7.5-9.5 7.5S3.1 17.4 2.5 13z' fill='#F6B73C'/><path d='M5 13.2c.7 2.6 3.6 4.4 7 4.4s6.3-1.8 7-4.4' fill='none' stroke='#5A0F1E' stroke-width='1.2' stroke-linecap='round'/></svg></span>
    <span class='pdw-txt'><span class='pdw-t1'>Diwali Special: scratch &amp; win ₹3,000 OFF</span><small class='pdw-t2'>Tap to open your Diwali scratch card</small></span>
    <span class='pdw-pill'>Scratch now</span>
  </button>
</div>

<div class='pdw-ov' id='pdw-ov-{{ id }}' role='dialog' aria-modal='true' aria-label='Diwali scratch card'>
  <button type='button' class='pdw-x' aria-label='Close'>×</button>
  <div class='pdw-scene'>
    <div class='pdw-card'>
      <div class='pdw-face pdw-front'>
        <svg class='pdw-big' viewBox='0 0 24 24' aria-hidden='true'><path d='M12 2.5c1.8 2.4 2.6 4.1 2.6 5.4a2.6 2.6 0 0 1-5.2 0c0-1.3.8-3 2.6-5.4z' fill='#FFD978'/><path d='M2.5 13h19c-.6 4.4-4.6 7.5-9.5 7.5S3.1 17.4 2.5 13z' fill='#F6B73C'/></svg>
        <h3>Happy Diwali</h3>
        <p>A festive gift from Pulse is inside…</p>
      </div>
      <div class='pdw-face pdw-back'>
        <span class='pdw-k'>Diwali scratch card</span>
        <h4>Scratch the gold to reveal your gift</h4>
        <div class='pdw-zone'>
          <div class='pdw-prize'><b>₹3,000 OFF</b><span>on {{ pdw_name | escape }}</span></div>
          <canvas aria-label='Scratch area'></canvas>
        </div>
        <p class='pdw-hint'>Use your finger or mouse to scratch</p>
        <div class='pdw-res'>
          <div class='pdw-np'>Your Diwali price<b>₹{% render 'pulse-inr', cents: pdw_new %}</b><s>₹{% render 'pulse-inr', cents: product.price %}</s></div>
          <p class='pdw-code'>Applied automatically at checkout · code <code>{{ pdw_code }}</code> · valid till 15 Nov</p>
          <button type='button' class='pdw-go'>Buy now at ₹{% render 'pulse-inr', cents: pdw_new %}</button>
          <button type='button' class='pdw-later'>Keep browsing</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('pdw-{{ id }}'), ov = document.getElementById('pdw-ov-{{ id }}');
  if (!root || !ov) return;
  document.body.appendChild(ov);
  var CODE = root.dataset.code, OFF = +root.dataset.off, PRICE = +root.dataset.price, COMPARE = +root.dataset.compare, VID = root.dataset.variant;
  var KEY = 'pulseDiwali3000';
  var inr = function (c) { return Math.round(c / 100).toLocaleString('en-IN'); };
  var get = function () { try { return localStorage.getItem(KEY) === '1'; } catch (e) { return false; } };
  var set = function () { try { localStorage.setItem(KEY, '1'); } catch (e) {} };
  var buyUrl = '/cart/' + VID + ':1?discount=' + encodeURIComponent(CODE);

  /* Show the Diwali price on the page and make every buy path carry the code. */
  function applyPage() {
    root.classList.add('done');
    root.querySelector('.pdw-t1').textContent = 'Diwali offer applied: ₹3,000 OFF';
    root.querySelector('.pdw-t2').textContent = 'Discount is added automatically at checkout';
    root.querySelector('.pdw-pill').textContent = 'Applied ✓';
    var box = root.closest('.ad-pricebox');
    if (box && !box.dataset.pdw) {
      box.dataset.pdw = '1';
      var p = box.querySelector('.ad-price'), b = p && p.querySelector('b');
      var newP = PRICE - OFF;
      if (b) {
        b.textContent = '₹' + inr(newP);
        var s = p.querySelector('s');
        if (!s) { s = document.createElement('s'); b.after(s); }
        s.textContent = '₹' + inr(COMPARE > PRICE ? COMPARE : PRICE);
        var off = p.querySelector('.ad-off'), base = COMPARE > PRICE ? COMPARE : PRICE;
        if (off) off.textContent = Math.round((base - newP) * 100 / base) + '% OFF';
        var tag = document.createElement('span'); tag.className = 'pdw-diwali-tag'; tag.textContent = 'Diwali −₹3,000'; p.appendChild(tag);
      }
      var save = box.querySelector('.ad-save');
      if (save) save.textContent = 'You save ₹' + inr((COMPARE > PRICE ? COMPARE : PRICE) - newP);
    }
    document.querySelectorAll('a[href^="/cart/' + VID + ':"]').forEach(function (a) { a.href = buyUrl; });
    /* Store the code in the shopper's cart session so Add to Cart + checkout also get it. */
    try { fetch('/discount/' + encodeURIComponent(CODE), { credentials: 'same-origin' }).catch(function () {}); } catch (e) {}
  }
  if (get()) applyPage();

  /* Scratch layer */
  var zone = ov.querySelector('.pdw-zone'), cv = zone.querySelector('canvas'), ctx = cv.getContext('2d'), ready = false, won = false;
  function paint() {
    var r = zone.getBoundingClientRect(), d = window.devicePixelRatio || 1;
    cv.width = Math.max(1, r.width * d); cv.height = Math.max(1, r.height * d);
    ctx.setTransform(d, 0, 0, d, 0, 0);
    var g = ctx.createLinearGradient(0, 0, r.width, r.height);
    g.addColorStop(0, '#C9902E'); g.addColorStop(.35, '#FFE08A'); g.addColorStop(.55, '#E2A83C'); g.addColorStop(.8, '#FFD978'); g.addColorStop(1, '#B67A22');
    ctx.globalCompositeOperation = 'source-over'; ctx.fillStyle = g; ctx.fillRect(0, 0, r.width, r.height);
    ctx.fillStyle = 'rgba(255,255,255,.18)';
    for (var i = 0; i < 70; i++) { ctx.beginPath(); ctx.arc(Math.random() * r.width, Math.random() * r.height, Math.random() * 2.2, 0, 7); ctx.fill(); }
    ctx.fillStyle = '#5A0F1E'; ctx.font = '800 17px system-ui,sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('✦ SCRATCH HERE ✦', r.width / 2, r.height / 2);
    ready = true;
  }
  var down = false, last = null, moves = 0;
  function pt(e) { var r = cv.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; }
  function scratch(p) {
    ctx.globalCompositeOperation = 'destination-out'; ctx.lineWidth = 38; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    ctx.beginPath(); if (last) { ctx.moveTo(last.x, last.y); ctx.lineTo(p.x, p.y); ctx.stroke(); } else { ctx.arc(p.x, p.y, 19, 0, 7); ctx.fill(); }
    last = p; if (++moves % 8 === 0) check();
  }
  function check() {
    if (won) return;
    var w = cv.width, h = cv.height, data = ctx.getImageData(0, 0, w, h).data, clear = 0, n = 0;
    for (var i = 3; i < data.length; i += 4 * 24) { n++; if (data[i] < 40) clear++; }
    if (clear / n > .45) win();
  }
  cv.addEventListener('pointerdown', function (e) { if (!ready || won) return; down = true; last = null; cv.setPointerCapture && cv.setPointerCapture(e.pointerId); scratch(pt(e)); e.preventDefault(); });
  cv.addEventListener('pointermove', function (e) { if (down && !won) { scratch(pt(e)); e.preventDefault(); } });
  ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (t) { cv.addEventListener(t, function () { down = false; last = null; if (ready && !won) check(); }); });

  function burst() {
    var cols = ['#FFD978', '#F6B73C', '#B3261E', '#E0661B', '#fff'];
    for (var i = 0; i < 26; i++) {
      var s = document.createElement('span'); s.className = 'pdw-spark';
      var a = Math.random() * Math.PI * 2, d = 60 + Math.random() * 110;
      s.style.left = '50%'; s.style.top = '50%'; s.style.background = cols[i % cols.length];
      s.style.setProperty('--dx', Math.cos(a) * d + 'px'); s.style.setProperty('--dy', Math.sin(a) * d + 'px');
      zone.appendChild(s); setTimeout(function (x) { return function () { x.remove(); }; }(s), 1200);
    }
  }
  function win() {
    won = true; zone.classList.add('clear'); ov.classList.add('won'); burst(); set(); applyPage();
  }

  function open() {
    ov.classList.add('open'); document.documentElement.style.overflow = 'hidden';
    if (get()) { won = true; zone.classList.add('clear'); ov.classList.add('won', 'flip'); return; }
    setTimeout(function () { ov.classList.add('flip'); }, 450);
    setTimeout(paint, 520);
  }
  function close() { ov.classList.remove('open'); document.documentElement.style.overflow = ''; }
  root.querySelector('.pdw-bar').addEventListener('click', open);
  ov.querySelector('.pdw-x').addEventListener('click', close);
  ov.querySelector('.pdw-later').addEventListener('click', close);
  ov.addEventListener('click', function (e) { if (e.target === ov) close(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && ov.classList.contains('open')) close(); });
  /* Buy now: go through the page's own Buy Now button so the sign-in step (pulse-cart.js) runs first.
     The Diwali code is already saved in the shopper's session (/discount/CODE), so checkout shows the ₹3,000 off. */
  ov.querySelector('.pdw-go').addEventListener('click', function () {
    close();
    var form = root.closest('.ad-pricebox') && root.closest('.ad-pricebox').parentElement.querySelector('form[data-pulse-atc]');
    var link = (form || document).querySelector('a[href*="/cart/' + VID + ':"]');
    if (link) { link.click(); return; }
    window.location.href = buyUrl;
  });
})();
</script>
