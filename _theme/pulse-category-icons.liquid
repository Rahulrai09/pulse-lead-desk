{{ 'pulse-custom.css' | asset_url | stylesheet_tag }}
{% style %}
  .pcx{--navy:#1B355E;--ink:#0F1E36;--org:#EE8B1B;--line:#E4E9F0;max-width:1152px;margin:2.75rem auto 0;padding:0 1.5rem;font-family:var(--pulse-font-sans,system-ui,sans-serif);}
  .pcx__head{display:flex;justify-content:center;margin-bottom:1.1rem;}
  .pcx__eyebrow{display:inline-flex;align-items:center;gap:.5rem;padding:.4rem .95rem;border-radius:999px;background:#FFF1E2;color:#C96F0C;font-size:.72rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;}
  .pcx__eyebrow:before{content:'';width:6px;height:6px;border-radius:50%;background:var(--org);}
  .pcx__row{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1rem;}
  .pcx__item{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;gap:.9rem;padding:1.6rem .9rem 1.3rem;border-radius:22px;background:linear-gradient(165deg,#FFFFFF 0%,#F4F7FC 100%);border:1px solid var(--line);box-shadow:0 1px 0 rgba(255,255,255,.9) inset,0 14px 30px -24px rgba(15,30,54,.45);text-decoration:none;color:var(--ink);overflow:hidden;isolation:isolate;transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s,border-color .35s;}
  .pcx__item:before{content:'';position:absolute;left:50%;top:0;width:0;height:3px;border-radius:0 0 3px 3px;background:linear-gradient(90deg,#F6A94B,var(--org));transform:translateX(-50%);transition:width .4s cubic-bezier(.2,.7,.2,1);}
  .pcx__item:after{content:'';position:absolute;z-index:-1;width:150px;height:150px;left:50%;top:-40px;transform:translateX(-50%);border-radius:50%;background:radial-gradient(closest-side,rgba(143,179,232,.35),rgba(143,179,232,0));opacity:.7;transition:opacity .35s;}
  .pcx__icon{position:relative;display:grid;place-items:center;width:64px;height:64px;border-radius:20px;color:#fff;background:linear-gradient(150deg,#2C5391 0%,#1B355E 60%,#132846 100%);box-shadow:0 12px 22px -12px rgba(27,53,94,.9),0 1px 0 rgba(255,255,255,.25) inset;transition:transform .35s cubic-bezier(.2,.7,.2,1);}
  .pcx__icon:after{content:'';position:absolute;right:-3px;top:-3px;width:12px;height:12px;border-radius:50%;background:var(--org);border:2.5px solid #fff;}
  .pcx__icon svg{width:28px;height:28px;}
  .pcx__label{display:flex;flex-direction:column;gap:.15rem;font-size:1.08rem;font-weight:700;line-height:1.2;letter-spacing:-.01em;color:var(--ink);}
  .pcx__label small{font-size:.78rem;font-weight:500;letter-spacing:.02em;color:#5B6B82;}
  .pcx__cta{margin-top:auto;display:inline-flex;align-items:center;gap:.35rem;font-size:.78rem;font-weight:700;color:var(--navy);opacity:.75;transition:opacity .3s,color .3s;}
  .pcx__cta svg{width:14px;height:14px;transition:transform .3s;}
  .pcx__item:hover{transform:translateY(-6px);border-color:#C9D6EA;box-shadow:0 26px 40px -26px rgba(15,30,54,.55);}
  .pcx__item:hover:before{width:56%;}
  .pcx__item:hover:after{opacity:1;}
  .pcx__item:hover .pcx__icon{transform:scale(1.06) rotate(-3deg);}
  .pcx__item:hover .pcx__cta{opacity:1;color:var(--org);}
  .pcx__item:hover .pcx__cta svg{transform:translateX(4px);}
  .pcx__item:focus-visible{outline:2px solid var(--navy);outline-offset:3px;}
  @media (max-width:989px){.pcx__row{gap:.7rem;}.pcx__item{padding:1.3rem .6rem 1.1rem;}.pcx__label{font-size:.95rem;}}
  @media (max-width:749px){
    .pcx{margin-top:1.75rem;padding:0 1rem;}
    .pcx__head{margin-bottom:.8rem;}
    .pcx__eyebrow{font-size:.62rem;padding:.32rem .75rem;}
    .pcx__row{gap:.3rem;padding:.9rem .3rem;border-radius:18px;background:linear-gradient(165deg,#FFFFFF,#F4F7FC);border:1px solid var(--line);box-shadow:0 14px 30px -24px rgba(15,30,54,.45);}
    .pcx__item{padding:0;gap:.45rem;background:none;border:0;box-shadow:none;border-radius:0;overflow:visible;}
    .pcx__item:before,.pcx__item:after,.pcx__cta{display:none;}
    .pcx__item:hover{transform:none;box-shadow:none;}
    /* Phones: the icons are just an overview, not links. */
    .pcx__item{pointer-events:none;cursor:default;-webkit-tap-highlight-color:transparent;}
    .pcx__icon{width:46px;height:46px;border-radius:15px;}
    .pcx__icon:after{width:9px;height:9px;border-width:2px;right:-2px;top:-2px;}
    .pcx__icon svg{width:21px;height:21px;}
    .pcx__label{font-size:.63rem;line-height:1.2;gap:.05rem;letter-spacing:-.015em;}
    .pcx__label small{font-size:.58rem;letter-spacing:0;}
  }
{% endstyle %}

<section class="pulse-section pcx">
  {%- if section.settings.eyebrow != blank -%}
    <div class="pcx__head"><span class="pcx__eyebrow">{{ section.settings.eyebrow }}</span></div>
  {%- endif -%}
  <div class="pcx__row">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link | default: '#' }}" class="pcx__item" {{ block.shopify_attributes }}>
        <span class="pcx__icon" aria-hidden="true">
          {% case block.settings.icon %}
            {% when 'bolt' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            {% when 'wheel' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v6M12 15v6M3 12h6M15 12h6"/></svg>
            {% when 'feather' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><path d="M16 8L2 22"/><path d="M17.5 15H9"/></svg>
            {% when 'suitcase' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2.5"/><path d="M8.5 7V5a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v2M3 12.5h18"/></svg>
            {% when 'speed' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 14l3.5-5"/><path d="M3.34 18a10 10 0 1 1 17.32 0"/><circle cx="12" cy="14" r="1.3" fill="currentColor"/></svg>
            {% when 'heart' %}
              {% render 'pulse-heart-icon' %}
          {% endcase %}
        </span>
        {%- liquid
          assign lbl = block.settings.label | strip
          assign lbl_main = lbl
          assign lbl_sub = ''
          if lbl contains ' Wheelchair'
            assign lbl_main = lbl | remove_last: ' Wheelchair' | strip
            assign lbl_sub = 'Wheelchair'
          endif
        -%}
        <span class="pcx__label">{{ lbl_main }}{% if lbl_sub != blank %}<small>{{ lbl_sub }}</small>{% endif %}</span>
        <span class="pcx__cta">Shop now<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Pulse Category Icons",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label above the categories", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
            { "value": "bolt", "label": "Bolt (Power)" },
            { "value": "wheel", "label": "Wheel (Manual)" },
            { "value": "feather", "label": "Feather (Lightweight)" },
            { "value": "suitcase", "label": "Suitcase (Travel)" },
            { "value": "speed", "label": "Speedometer (Speed)" },
            { "value": "heart", "label": "Heart (Comfort)" }
          ], "default": "bolt" },
        { "type": "text", "id": "label", "label": "Label", "default": "Power Wheelchair" },
        { "type": "url", "id": "link", "label": "Link to collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pulse Category Icons",
      "blocks": [
        { "type": "category", "settings": { "icon": "bolt", "label": "Power Wheelchair" } },
        { "type": "category", "settings": { "icon": "feather", "label": "Lightweight Wheelchair" } },
        { "type": "category", "settings": { "icon": "suitcase", "label": "Travel Wheelchair" } },
        { "type": "category", "settings": { "icon": "speed", "label": "Speed Wheelchair" } },
        { "type": "category", "settings": { "icon": "heart", "label": "Comfortable Wheelchair" } }
      ]
    }
  ]
}
{% endschema %}