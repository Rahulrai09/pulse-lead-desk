{%- comment -%}
  Pulse: Shopify's standard robots.txt, plus a few extra lines so Google doesn't spend time on
  addresses that are never meant to show in search. /agents.md (Shopify's guide for AI shopping assistants) and theme code files are NOT blocked:
  Google needs them to draw the pages correctly.
{%- endcomment -%}
{%- capture nl %}
{% endcapture -%}
{% for group in robots.default_groups %}
  {{- group.user_agent }}

  {%- for rule in group.rules -%}
    {{ rule }}
  {%- endfor -%}

  {%- if group.user_agent.value == '*' -%}
    {{- 'Disallow: /*?*_pos=' | append: nl -}}
    {{- 'Disallow: /*?*_sid=' | append: nl -}}
    {{- 'Disallow: /*?*_ss=' | append: nl -}}
    {{- 'Disallow: /*?*jdgm_' | append: nl -}}
    {{- 'Disallow: /*.atom' | append: nl -}}
    {{- 'Disallow: /wpm' | append: nl -}}
    {{- 'Disallow: /api/' | append: nl -}}
    {{- 'Disallow: /v1/' | append: nl -}}
    {{- 'Disallow: /b$' | append: nl -}}
  {%- endif -%}

  {%- if group.sitemap != blank -%}
    {{ group.sitemap }}
  {%- endif %}
{% endfor %}
