{{ 'pulse-custom.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign img1 = nil
  assign mob1 = nil
  for i in (1..6)
    assign key = 'image_' | append: i
    assign mkey = 'mobile_image_' | append: i
    if section.settings[key] != blank and img1 == blank
      assign img1 = section.settings[key]
      assign mob1 = section.settings[mkey]
    endif
  endfor
-%}
{%- if img1 != blank -%}
  {%- if mob1 != blank -%}
    <link rel="preload" as="image" fetchpriority="high" media="(max-width: 749px)" imagesrcset="{{ mob1 | image_url: width: 750 }} 750w, {{ mob1 | image_url: width: 1080 }} 1080w" imagesizes="100vw">
    <link rel="preload" as="image" fetchpriority="high" media="(min-width: 750px)" imagesrcset="{{ img1 | image_url: width: 1400 }} 1400w, {{ img1 | image_url: width: 1920 }} 1920w" imagesizes="100vw">
  {%- else -%}
    <link rel="preload" as="image" fetchpriority="high" imagesrcset="{{ img1 | image_url: width: 900 }} 900w, {{ img1 | image_url: width: 1400 }} 1400w, {{ img1 | image_url: width: 1920 }} 1920w" imagesizes="100vw">
  {%- endif -%}
{%- endif -%}
{% style %}
  /* Quick, clean crossfade so two banners are never visible on top of each other. */
  #pulse-hero-{{ section.id }} .pulse-hero__slide{transition:opacity .6s ease;will-change:opacity;}
  /* Swipe left/right on the banner to change slides; up/down still scrolls the page. */
  #pulse-hero-{{ section.id }}{touch-action:pan-y;user-select:none;-webkit-user-select:none;}
  {%- if section.settings.mobile_square %}
  @media (max-width:749px){#pulse-hero-{{ section.id }}.pulse-hero{aspect-ratio:1/1;}}
  {%- endif %}
  {%- assign n = 0 -%}
  {%- for i in (1..6) -%}
    {%- assign key = 'image_' | append: i -%}
    {%- assign mkey = 'mobile_image_' | append: i -%}
    {%- assign img = section.settings[key] -%}
    {%- assign mob = section.settings[mkey] -%}
    {%- if img != blank -%}
      {%- assign n = n | plus: 1 -%}
      {%- if n == 1 -%}{%- assign sel = '' -%}{%- else -%}{%- assign sel = '.is-ready' -%}{%- endif %}
  {%- if mob != blank %}
  #pulse-hero-{{ section.id }}{{ sel }} .pulse-hero__slide--{{ n }}{background-image:url({{ mob | image_url: width: 1080 }});}
  {%- else %}
  #pulse-hero-{{ section.id }}{{ sel }} .pulse-hero__slide--{{ n }}{background-image:url({{ img | image_url: width: 900 }});}
  {%- endif %}
  @media (min-width:750px){#pulse-hero-{{ section.id }}{{ sel }} .pulse-hero__slide--{{ n }}{background-image:url({{ img | image_url: width: 1400 }});}}
  @media (min-width:1400px){#pulse-hero-{{ section.id }}{{ sel }} .pulse-hero__slide--{{ n }}{background-image:url({{ img | image_url: width: 1920 }});}}
    {%- endif -%}
  {%- endfor %}
{% endstyle %}

<section class="pulse-section pulse-hero" id="pulse-hero-{{ section.id }}">
  {%- assign n = 0 -%}
  {%- for i in (1..6) -%}
    {%- assign key = 'image_' | append: i -%}
    {%- assign img = section.settings[key] -%}
    {%- if img != blank -%}
      {%- assign n = n | plus: 1 -%}
      <div class="pulse-hero__slide pulse-hero__slide--{{ n }}{% if n == 1 %} is-active{% endif %}" role="img" aria-label="{{ img.alt | default: shop.name | escape }}"></div>
    {%- endif -%}
  {%- endfor -%}

  {% if section.settings.heading != blank %}
    <div class="pulse-hero__caption">
      <h1>{{ section.settings.heading }}</h1>
    </div>
  {% endif %}

  {%- if n > 1 -%}
  <div class="pulse-hero__dots">
    {%- for d in (1..n) -%}
      <button class="pulse-hero__dot{% if d == 1 %} is-active{% endif %}" data-index="{{ d | minus: 1 }}" aria-label="Slide {{ d }}"></button>
    {%- endfor -%}
  </div>
  {%- endif -%}
</section>

<script>
(function () {
  var root = document.getElementById('pulse-hero-{{ section.id }}');
  if (!root) return;
  var slides = root.querySelectorAll('.pulse-hero__slide');
  var dots = root.querySelectorAll('.pulse-hero__dot');
  var idx = 0, timer = null;
  /* The other banners download only after the page has finished loading. */
  function ready() { root.classList.add('is-ready'); }
  if (document.readyState === 'complete') ready(); else window.addEventListener('load', ready, { once: true });
  function show(i) {
    ready();
    slides.forEach(function (s, si) { s.classList.toggle('is-active', si === i); });
    dots.forEach(function (d, di) { d.classList.toggle('is-active', di === i); });
    idx = i;
  }
  function start() { if (slides.length > 1 && !timer) timer = setInterval(function () { show((idx + 1) % slides.length); }, 6000); }
  function stop() { clearInterval(timer); timer = null; }
  dots.forEach(function (d) {
    d.addEventListener('click', function () { stop(); show(parseInt(d.dataset.index, 10)); start(); });
  });
  /* Swipe with a finger (phones/tablets) or drag with the mouse: left = next banner, right = previous. */
  if (slides.length > 1) {
    var sx = null, sy = 0, moved = false;
    function down(x, y) { sx = x; sy = y; moved = false; stop(); }
    function up(x, y) {
      if (sx === null) return;
      var dx = x - sx, dy = y - sy; sx = null;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.2) {
        moved = true;
        show(dx < 0 ? (idx + 1) % slides.length : (idx - 1 + slides.length) % slides.length);
      }
      start();
    }
    root.addEventListener('touchstart', function (e) { var t = e.touches[0]; down(t.clientX, t.clientY); }, { passive: true });
    root.addEventListener('touchend', function (e) { var t = e.changedTouches[0]; up(t.clientX, t.clientY); }, { passive: true });
    root.addEventListener('touchcancel', function () { sx = null; start(); }, { passive: true });
    root.addEventListener('mousedown', function (e) { if (e.button === 0 && !e.target.closest('button,a')) { down(e.clientX, e.clientY); e.preventDefault(); } });
    window.addEventListener('mouseup', function (e) { up(e.clientX, e.clientY); });
    /* A swipe should never also count as a click on something inside the banner. */
    root.addEventListener('click', function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
  }
  document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
  start();
})();
</script>

{% schema %}
{
  "name": "Pulse Hero Slideshow",
  "settings": [
    { "type": "paragraph", "content": "Desktop banner: 1920 × 768 px (5:2). Mobile banner: 1080 × 1080 px (square). If a slide has no mobile banner, phones show the centre of the desktop banner. Visitors can swipe (or drag) the banner to change slides." },
    { "type": "checkbox", "id": "mobile_square", "label": "Square banner on phones", "default": true },
    { "type": "header", "content": "Slide 1" },
    { "type": "image_picker", "id": "image_1", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image_1", "label": "Mobile image" },
    { "type": "header", "content": "Slide 2" },
    { "type": "image_picker", "id": "image_2", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image_2", "label": "Mobile image" },
    { "type": "header", "content": "Slide 3" },
    { "type": "image_picker", "id": "image_3", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image_3", "label": "Mobile image" },
    { "type": "header", "content": "Slide 4" },
    { "type": "image_picker", "id": "image_4", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image_4", "label": "Mobile image" },
    { "type": "header", "content": "Slide 5" },
    { "type": "image_picker", "id": "image_5", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image_5", "label": "Mobile image" },
    { "type": "header", "content": "Slide 6" },
    { "type": "image_picker", "id": "image_6", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image_6", "label": "Mobile image" },
    { "type": "text", "id": "heading", "label": "Heading text (optional)", "default": "Designed for Comfort. Built for Independence." }
  ],
  "presets": [{ "name": "Pulse Hero Slideshow" }]
}
{% endschema %}
