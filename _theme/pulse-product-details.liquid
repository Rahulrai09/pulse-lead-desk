      {%- else -%}
      <div class='ad-c ad-s3'>{% if product.metafields.pulse.badges.value contains '160° Recline' %}<h3>Reclining Comfort Seat</h3><p>Reclines up to 160°{% if spec_seat != blank %}<br>Seat {{ spec_seat }}{% endif %}</p>{% else %}<h3>Comfortable Seat</h3><p>{% if spec_seat != blank %}Seat {{ spec_seat }}{% else %}Made for all-day sitting{% endif %}</p>{% endif %}{% if section.settings.closeup_seat != blank %}{{ section.settings.closeup_seat | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Comfort seat close-up' }}{% else %}{% if isz > 0 %}{% assign ci = 2 | modulo: isz %}<img src='{{ product.images[ci] | image_url: width: 600 }}' alt='Comfort seat close-up' loading='lazy'>{% endif %}{% endif %}</div>
      {%- endif -%}
      {%- if product.metafields.pulse.hl_3.value != blank -%}
