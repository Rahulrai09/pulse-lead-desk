{%- liquid
  assign desc_parts = product.description | split: '===SPECIFICATIONS==='
  assign desc_html = desc_parts[0]
  assign spec_items = desc_parts[1] | split: '</p>'
  assign spec_range = ''
  assign spec_load = ''
  assign spec_weight = ''
  assign spec_frame = ''
  assign spec_seat = ''
  assign spec_battery = ''
  assign spec_wheels = ''
  assign spec_tyres = ''
  for item in spec_items
    assign line = item | strip_html | strip
    if line contains ':'
      assign key = line | split: ':' | first | strip
      assign val = line | remove_first: key | remove_first: ':' | strip
      if key == 'Driving Range'
        assign spec_range = val
      elsif key == 'Max Load Capacity'
        assign spec_load = val
      elsif key == 'Net Weight'
        assign spec_weight = val
      elsif key == 'Frame Material'
        assign spec_frame = val
      elsif key == 'Seat Size'
        assign spec_seat = val
      elsif key == 'Battery'
        assign spec_battery = val
      elsif key == 'Front / Rear Wheels'
        assign spec_wheels = val
      elsif key == 'Tyres'
        assign spec_tyres = val
      endif
    endif
  endfor
  assign hl_range = ''
  if spec_range != blank
    assign hl_parts = spec_range | replace: '–', '-' | replace: '—', '-' | split: '-'
    assign hl_range = hl_parts | last | strip
    unless hl_range contains 'km'
      assign hl_range = hl_range | append: ' km'
    endunless
  endif
  assign has_discount = false
  if product.compare_at_price > product.price
    assign has_discount = true
    assign diff = product.compare_at_price | minus: product.price
    assign half = product.compare_at_price | divided_by: 2
    assign off_pct = diff | times: 100 | plus: half | divided_by: product.compare_at_price
  endif
  assign tags = product.tags
  assign isz = product.images.size
  assign summary = desc_html | replace: '</p>', '</p> ' | replace: '</li>', '</li> ' | strip_html | strip_newlines | strip | truncate: 160
  assign ad_variant = product.selected_or_first_available_variant
  assign ad_phone = section.settings.phone_number | default: section.settings.whatsapp_number
  assign ad_phone_label = section.settings.phone_label | default: ad_phone
  assign warranty_handle = section.settings.warranty_page | default: 'warranty-policy'
  assign warranty_page = pages[warranty_handle]
  assign returns_handle = section.settings.returns_page | default: 'returns-service'
  assign returns_page = pages[returns_handle]
  assign manual_file = product.metafields.custom.owners_manual.value
  # Specs and tags already shown on this page as icons or cards are not repeated
  # in the Product Details table or the Quick Product Highlights cards.
  assign shown_keys = 'Driving Range|Max Load Capacity|Net Weight|Frame Material' | split: '|'
  assign dup_words = 'Range|Battery|Brake|Fold|Light|Frame|Carbon|Control|Joystick|360°|Ah|Iron' | split: '|'
  assign hl_list = ''
  for tag in product.tags
    assign is_dup = false
    for w in dup_words
      if tag contains w
        assign is_dup = true
        break
      endif
    endfor
    unless is_dup
      assign hl_list = hl_list | append: tag | append: '|~|'
    endunless
  endfor
  assign hl_tags = hl_list | split: '|~|'
  assign hn = hl_tags.size | at_most: 5
-%}
{{ 'pulse-custom.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'pulse-cart.js' | asset_url }}"></script>
{% style %}
  .ad{--navy:#1B355E;--ink:#0F1E36;--mut:#5B6B82;--org:#EE8B1B;--grn:#0B7A57;--grn-bg:#E3F7F0;--card:#EEF3F9;--line:#E4E9F0;--soft:#F5F7FA;max-width:1240px;margin:0 auto;padding:0 24px 56px;font-family:var(--pulse-font-sans,system-ui,sans-serif);font-size:14px;color:var(--ink);-webkit-font-smoothing:antialiased;}
  .ad *{box-sizing:border-box;}
  .ad svg{flex-shrink:0;}
  .ad-crumb{font-size:12px;color:var(--mut);padding:22px 0 20px;}
  .ad-crumb a{color:inherit;text-decoration:none;transition:color .2s;}.ad-crumb a:hover{color:var(--navy);}
  .ad-crumb span{margin:0 8px;opacity:.5;}
  .ad-top{display:grid;grid-template-columns:1.1fr 1fr;gap:56px;align-items:start;}
  .ad-gal{--gal-h:540px;display:grid;grid-template-columns:84px minmax(0,1fr);gap:16px;align-items:start;position:sticky;top:96px;}
  .ad-gal--one{grid-template-columns:minmax(0,1fr);}
  .ad-thw{height:var(--gal-h);display:flex;flex-direction:column;gap:8px;min-width:0;}
  .ad-th{flex:1;min-height:0;display:flex;flex-direction:column;gap:10px;overflow-y:auto;overflow-x:hidden;scroll-snap-type:y proximity;scroll-behavior:smooth;overscroll-behavior:contain;scrollbar-width:none;}
  .ad-th::-webkit-scrollbar{display:none;}
  .ad .ad-t{flex:0 0 auto;width:84px;height:84px;min-height:0;border:1px solid var(--line);border-radius:14px;background:#fff;overflow:hidden;padding:5px;cursor:pointer;scroll-snap-align:start;transition:border-color .2s;}
  .ad .ad-t img{width:100%;height:100%;object-fit:contain;display:block;}
  .ad .ad-t:hover{border-color:#C9D4E3;}.ad .ad-t.on{border:2px solid var(--navy);}
  .ad .ad-tnav{flex:0 0 auto;width:84px;height:30px;min-height:0;padding:0;margin:0;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--navy);display:grid;place-items:center;cursor:pointer;transition:all .2s;}
  .ad .ad-tnav svg{width:16px;height:16px;}
  .ad .ad-tnav:hover:not([disabled]){background:var(--navy);color:#fff;border-color:var(--navy);}
  .ad .ad-tnav[disabled]{opacity:.35;cursor:default;}
  .ad .ad-tnav[hidden]{display:none;}
  .ad-stage{position:relative;height:var(--gal-h);border:1px solid var(--line);border-radius:24px;background:radial-gradient(110% 90% at 50% 25%,#fff 0%,#F1F5FA 65%,#E6ECF4 100%);overflow:hidden;}
  .ad-track{display:flex;height:100%;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scroll-behavior:smooth;overscroll-behavior-x:contain;scrollbar-width:none;cursor:grab;}
  .ad-track::-webkit-scrollbar{display:none;}
  .ad-track.drag{cursor:grabbing;scroll-snap-type:none;scroll-behavior:auto;}
  .ad-slide{flex:0 0 100%;height:100%;scroll-snap-align:center;scroll-snap-stop:always;display:flex;align-items:center;justify-content:center;padding:32px;}
  .ad-slide img{max-width:100%;max-height:100%;object-fit:contain;mix-blend-mode:multiply;-webkit-user-drag:none;user-select:none;pointer-events:none;}
  .ad-count{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);background:rgba(15,30,54,.72);color:#fff;font-size:12px;font-weight:600;padding:4px 11px;border-radius:999px;letter-spacing:.04em;pointer-events:none;}
  .ad .ad-arr{position:absolute;top:50%;transform:translateY(-50%);width:42px;height:42px;min-height:0;padding:0;border-radius:50%;background:#fff;color:var(--navy);font-size:22px;line-height:1;display:grid;place-items:center;border:1px solid var(--line);cursor:pointer;box-shadow:0 8px 20px -10px rgba(15,30,54,.35);transition:all .2s;}
  .ad .ad-arr:hover{background:var(--navy);color:#fff;border-color:var(--navy);}
  .ad .ad-a1{left:16px;}.ad .ad-a2{right:16px;}
  .ad-rate{font-size:12px;font-weight:600;color:var(--navy);min-height:16px;margin-bottom:8px;}
  .ad-eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:11.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--org);text-decoration:none;}
  .ad-eyebrow:before{content:'';width:24px;height:1.5px;background:currentColor;}
  .ad h1.ad-h1 .ad-eyebrow--name{display:flex;width:max-content;max-width:100%;margin:0 0 10px;line-height:1.3;}
  .ad h1.ad-h1{font-size:clamp(26px,2.8vw,36px);line-height:1.15;letter-spacing:-.02em;color:var(--ink);font-weight:700;margin:12px 0 12px;}
  .ad-titlerow{display:flex;align-items:flex-start;gap:16px;margin:12px 0 12px;}
  .ad .ad-titlerow h1.ad-h1{margin:0;flex:1;min-width:0;}
  .ad-sub{font-size:14.5px;line-height:1.65;color:var(--mut);margin:0;max-width:540px;}
  .ad-pricebox{margin-top:24px;padding-top:22px;border-top:1px solid var(--line);}
  .ad-price{display:flex;align-items:center;flex-wrap:wrap;gap:12px;}
  .ad-price b{font-size:34px;font-weight:700;letter-spacing:-.02em;color:var(--ink);line-height:1;}
  .ad-price s{font-size:15px;color:var(--mut);}
  .ad-off{background:var(--grn-bg);color:var(--grn);font-size:12px;font-weight:700;padding:5px 10px;border-radius:999px;letter-spacing:.02em;}
  .ad-tax{font-size:12.5px;color:var(--mut);margin-top:8px;}
  .ad-save{color:var(--grn);font-weight:600;}
  .ad-emi{margin-top:16px;display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:12px;background:var(--soft);border:1px solid var(--line);font-size:13px;font-weight:600;color:var(--navy);}
  .ad-emi svg{width:18px;height:18px;}
  .ad-btns{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:24px;}
  .ad .ad-btn{width:100%;height:54px;min-height:0;padding:0 16px;margin:0;border-radius:12px;font:700 15px/1 var(--pulse-font-sans,system-ui,sans-serif);letter-spacing:normal;text-transform:none;display:flex;align-items:center;justify-content:center;gap:10px;text-decoration:none;cursor:pointer;transition:all .25s cubic-bezier(.2,.7,.2,1);}
  .ad .ad-btn svg{width:18px;height:18px;transition:transform .25s;}
  .ad .ad-btn--ghost{background:#fff;color:var(--navy);border:1.5px solid var(--navy);box-shadow:none;}
  .ad .ad-btn--ghost:hover{background:var(--navy);color:#fff;}
  .ad .ad-btn--primary{background:linear-gradient(180deg,#24467A,#1B355E);color:#fff;border:0;box-shadow:0 12px 24px -12px rgba(27,53,94,.75);}
  .ad .ad-btn--primary:hover{transform:translateY(-1px);box-shadow:0 16px 30px -12px rgba(27,53,94,.85);color:#fff;}
  .ad .ad-btn--primary:hover svg{transform:translateX(3px);}
  .ad .ad-btn[disabled]{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none;}
  .ad-alt{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px;}
  .ad .ad-alt a{height:48px;border-radius:12px;border:1px solid var(--line);background:#fff;color:var(--ink);font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;transition:border-color .2s,background .2s;}
  .ad .ad-alt a:hover{border-color:var(--navy);background:var(--soft);}
  .ad-alt svg{width:18px;height:18px;}
  .ad-wa svg{color:#002A74;width:19px;height:19px;}.ad .ad-alt a.ad-wa{transition:background .2s,border-color .2s,color .2s;}.ad .ad-alt a.ad-wa:hover,.ad .ad-alt a.ad-wa:focus-visible{background:#25D366;border-color:#25D366;color:#fff;}.ad .ad-alt a.ad-wa:hover svg,.ad .ad-alt a.ad-wa:focus-visible svg{color:#fff;}.ad-wa svg *{transition:fill .2s,stroke .2s;}.ad-tel svg{color:var(--navy);}
  .ad-hl4{display:grid;grid-template-columns:1fr 1fr;gap:18px 20px;margin:24px 0 0;padding:22px 0 0;border-top:1px solid var(--line);list-style:none;}
  .ad-hl4 li{display:flex;align-items:center;gap:14px;font-size:14.5px;line-height:1.35;color:#3B4A62;}
  .ad-hl4 li b{color:var(--ink);font-weight:700;}
  .ad-hl4 i{flex-shrink:0;display:grid;place-items:center;width:62px;height:62px;border-radius:50%;border:1px solid var(--line);background:#fff;box-shadow:0 6px 14px -10px rgba(15,30,54,.35);}
  .ad-hl4 i svg{width:34px;height:34px;}
  .ad-assure{list-style:none;display:flex;flex-wrap:wrap;gap:10px 22px;margin:20px 0 0;padding:18px 0 0;border-top:1px solid var(--line);}
  .ad-assure li{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:var(--mut);}
  .ad-assure svg{width:17px;height:17px;color:var(--navy);}
  .ad-del{margin-top:22px;}
  .ad-del label{display:block;font-size:13px;font-weight:700;color:var(--ink);margin-bottom:10px;}
  .ad-delr{display:flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:6px 6px 6px 14px;transition:border-color .2s;}
  .ad-delr:focus-within{border-color:var(--navy);}
  .ad-delr svg{width:18px;height:18px;color:var(--mut);}
  .ad .ad-delr input{border:0;outline:0;box-shadow:none;background:transparent;font:500 14px var(--pulse-font-sans,system-ui,sans-serif);color:var(--ink);flex:1;min-width:0;padding:8px 0;height:auto;min-height:0;}
  .ad .ad-delr button{background:var(--navy);color:#fff;border:0;border-radius:9px;height:40px;min-height:0;padding:0 22px;font:700 13px var(--pulse-font-sans,system-ui,sans-serif);cursor:pointer;transition:background .2s;}
  .ad .ad-delr button:hover{background:var(--ink);}
  .ad-delmsg{font-size:12.5px;margin:8px 0 0;color:var(--grn);}
  .ad-delmsg.err{color:#B42318;}
  .ad-fs{display:grid;grid-template-columns:repeat(5,1fr);text-align:center;margin:56px 0 8px;padding:28px 12px;background:#fff;border:1px solid var(--line);border-radius:22px;color:var(--ink);font-size:15px;font-weight:700;}
  .ad-fs > div + div{border-left:1px solid var(--line);}
  .ad-fs i{display:grid;place-items:center;width:50px;height:50px;margin:0 auto 10px;border-radius:50%;background:var(--card);color:var(--navy);}
  .ad-fs i svg{width:22px;height:22px;}
  .ad-fs i .acc{stroke:#F7A640;}
  .ad-fs small{display:block;font-weight:500;color:var(--mut);font-size:12.5px;margin-top:4px;}
  .ad h2.ad-h2{text-align:center;font-size:clamp(26px,3vw,34px);color:var(--ink);font-weight:700;margin:56px 0 24px;letter-spacing:-.02em;}
  .ad-hl{display:grid;grid-template-columns:1fr 2.15fr;gap:14px;}
  .ad-c{background:var(--card);border-radius:16px;padding:18px 20px;overflow:hidden;position:relative;}
  .ad-c h3{font-size:15px;color:var(--ink);font-weight:700;line-height:1.3;}.ad-c p{font-size:12px;color:var(--mut);margin-top:6px;line-height:1.6;}
  .ad-c img{display:block;width:100%;object-fit:cover;}
  .ad-big{display:flex;flex-direction:column;}.ad-big h3{font-size:22px;}.ad-big p{font-size:15px;color:var(--ink);}.ad-big img{margin-top:auto;object-fit:contain;height:340px;}
  .ad-g6{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;}
  .ad-s3{grid-column:span 3;}.ad-s2{grid-column:span 2;}
  .ad-s3 img{height:120px;margin:8px -20px -18px;width:calc(100% + 40px);}.ad-s2 img{height:150px;margin:8px -20px -18px;width:calc(100% + 40px);}
  .ad-s2 h3{font-size:14px;}.ad-s2 p{font-size:10px;}
  .ad-s6{grid-column:span 6;display:flex;flex-direction:column;}.ad-s6 img{margin:12px -20px -18px auto;width:calc(100% + 40px);height:300px;object-fit:contain;}
  .ad-hl--solo{grid-template-columns:1fr;}
  .ad-hlwrap{position:relative;isolation:isolate;overflow:hidden;margin:56px 0 0;padding:4px 28px 32px;border-radius:32px;background:linear-gradient(155deg,var(--hl-a) 0%,color-mix(in srgb,var(--hl-a) 70%,var(--hl-b)) 45%,color-mix(in srgb,var(--hl-a) 25%,var(--hl-b)) 80%,var(--hl-b) 115%);box-shadow:0 40px 80px -50px color-mix(in srgb,var(--hl-b) 80%,transparent);}
  .ad-hlwrap:before{content:'';position:absolute;inset:0;z-index:-1;background:radial-gradient(55% 45% at 88% 8%,color-mix(in srgb,var(--hl-b) 55%,transparent),transparent 70%),radial-gradient(45% 55% at 6% 96%,color-mix(in srgb,var(--hl-b) 45%,transparent),transparent 70%);}
  .ad-hlwrap:after{content:'';position:absolute;inset:0;z-index:-1;background:url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%201200%20900%27%20preserveAspectRatio%3D%27none%27%3E%3Cdefs%3E%3Cfilter%20id%3D%27b%27%20x%3D%27-20%25%27%20y%3D%27-20%25%27%20width%3D%27140%25%27%20height%3D%27140%25%27%3E%3CfeGaussianBlur%20stdDeviation%3D%276%27/%3E%3C/filter%3E%3C/defs%3E%3Cg%20fill%3D%27none%27%20stroke%3D%27%23fff%27%20stroke-linecap%3D%27round%27%20filter%3D%27url%28%23b%29%27%3E%3Cpath%20d%3D%27M-50%20700C150%20560%20260%20760%20430%20600S640%20300%20820%20380%201050%20640%201260%20420%27%20stroke-width%3D%2760%27%20stroke-opacity%3D%27.10%27/%3E%3Cpath%20d%3D%27M-50%20640C170%20520%20280%20700%20450%20560S660%20260%20840%20330%201060%20600%201260%20360%27%20stroke-width%3D%2718%27%20stroke-opacity%3D%27.22%27/%3E%3Cpath%20d%3D%27M-50%20760C190%20600%20300%20820%20480%20650S700%20360%20880%20440%201080%20700%201260%20500%27%20stroke-width%3D%278%27%20stroke-opacity%3D%27.28%27/%3E%3Cpath%20d%3D%27M-50%20220C140%20120%20300%20300%20480%20200S760%2040%20940%20140%201120%20260%201260%20120%27%20stroke-width%3D%2740%27%20stroke-opacity%3D%27.07%27/%3E%3Cpath%20d%3D%27M-50%20260C160%20160%20310%20330%20500%20230S780%2080%20960%20180%201130%20300%201260%20170%27%20stroke-width%3D%276%27%20stroke-opacity%3D%27.20%27/%3E%3C/g%3E%3C/svg%3E") center/100% 100% no-repeat;mix-blend-mode:screen;opacity:.55;pointer-events:none;}
  .ad-hlwrap h2.ad-h2{color:#fff;margin:44px 0 28px;text-shadow:0 2px 18px rgba(0,0,0,.35);}
  .ad-hlwrap .ad-c{box-shadow:0 22px 44px -26px rgba(0,0,0,.75);}
  .ad-hlwrap .ad-b2c{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(6px);}
  .ad-hlwrap--steel{background:linear-gradient(118deg,color-mix(in srgb,var(--hl-a) 82%,#000) 0%,var(--hl-a) 26%,color-mix(in srgb,var(--hl-a) 55%,var(--hl-b)) 44%,color-mix(in srgb,var(--hl-b) 80%,#fff) 51%,color-mix(in srgb,var(--hl-a) 50%,var(--hl-b)) 58%,var(--hl-a) 76%,color-mix(in srgb,var(--hl-a) 80%,#000) 100%);border:1px solid color-mix(in srgb,var(--hl-b) 40%,transparent);box-shadow:inset 0 1px 0 color-mix(in srgb,var(--hl-b) 75%,transparent),inset 0 -1px 0 rgba(0,0,0,.4),0 40px 80px -50px color-mix(in srgb,var(--hl-a) 90%,transparent);}
  .ad-hlwrap--steel:before{background:repeating-linear-gradient(118deg,rgba(255,255,255,.05) 0 1px,transparent 1px 7px),linear-gradient(90deg,transparent 8%,color-mix(in srgb,var(--hl-b) 90%,#fff) 50%,transparent 92%) top/100% 2px no-repeat,radial-gradient(35% 28% at 50% 0%,color-mix(in srgb,var(--hl-b) 45%,transparent),transparent 70%);}
  .ad-hlwrap--steel:after{background:url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%20600%20600%27%3E%3Cg%20fill%3D%27none%27%20stroke%3D%27%23fff%27%20stroke-opacity%3D%27.55%27%3E%3Ccircle%20cx%3D%27300%27%20cy%3D%27300%27%20r%3D%27290%27%20stroke-width%3D%273%27%2F%3E%3Ccircle%20cx%3D%27300%27%20cy%3D%27300%27%20r%3D%27262%27%20stroke-width%3D%271.2%27%2F%3E%3Ccircle%20cx%3D%27300%27%20cy%3D%27300%27%20r%3D%27200%27%20stroke-width%3D%271%27%2F%3E%3Ccircle%20cx%3D%27300%27%20cy%3D%27300%27%20r%3D%2746%27%20stroke-width%3D%273%27%2F%3E%3Ccircle%20cx%3D%27300%27%20cy%3D%27300%27%20r%3D%2718%27%20stroke-width%3D%271.5%27%2F%3E%3Cg%20stroke-width%3D%271.2%27%3E%3Cpath%20d%3D%27M300%2046V254M300%20346V554M46%20300H254M346%20300H554M120%20120L267%20267M333%20333L480%20480M480%20120L333%20267M267%20333L120%20480%27%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E") no-repeat right -160px bottom -200px/680px 680px;opacity:.4;mix-blend-mode:normal;}
  .ad-hlwrap--steel .ad-b2c{background:linear-gradient(135deg,rgba(255,255,255,.12),rgba(255,255,255,.04));border:1px solid color-mix(in srgb,var(--hl-b) 35%,transparent);}
