          </a>
          <a href="https://wa.me/{{ ppc_wa }}?text={{ ppc_wa_text | url_encode }}" target="_blank" rel="noopener" class="pulse-card__icon-btn pulse-card__icon-btn--wa" aria-label="Chat on WhatsApp about the {{ product.title | escape }}" title="Chat on WhatsApp">
