          </a>
          {% if product.available %}
            <button type="submit" name="add" class="pulse-card__icon-btn" aria-label="Add to cart" title="Add to cart">
              <svg class="pulse-ico pulse-ico--bag" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1074.000000 1074.000000" fill="currentColor" aria-hidden="true"><path transform="translate(0.000000,1074.000000) scale(0.100000,-0.100000)" d="M4635 10225 c-582 -93 -1077 -524 -1269 -1105 -74 -224 -79 -269 -85 -895 l-6 -560 -570 -5 c-623 -6 -579 -1 -712 -68 -118 -60 -223 -181 -271 -311 -33 -93 -121 -718 -292 -2081 -11 -85 -24 -186 -30 -225 -6 -38 -35 -261 -65 -495 -29 -234 -65 -510 -79 -615 -14 -104 -55 -426 -91 -715 -86 -691 -141 -1093 -225 -1637 -38 -245 -41 -438 -9 -553 55 -201 197 -354 389 -421 98 -34 355 -37 3830 -38 3387 -1 3151 -5 3289 59 85 40 160 99 209 164 136 180 156 333 103 806 -16 151 -45 425 -62 608 l-32 332 -76 0 c-42 -1 -96 -5 -121 -10 -25 -5 -102 -13 -172 -16 l-128 -7 0 -101 c0 -56 7 -171 15 -256 24 -260 53 -566 70 -739 9 -89 14 -173 11 -185 -11 -46 -67 -107 -119 -132 l-52 -24 -3200 0 c-2046 0 -3222 4 -3260 10 -74 12 -129 49 -169 113 l-29 47 42 272 c22 150 52 356 66 458 13 102 36 264 49 360 27 187 89 642 105 775 6 44 33 251 61 460 28 209 73 553 100 765 28 212 61 468 75 570 14 102 50 374 80 605 227 1746 207 1632 300 1690 l48 30 464 3 464 3 -3 -143 -3 -143 -76 -5 c-88 -7 -134 -33 -163 -95 -28 -59 -20 -278 12 -323 52 -72 54 -72 501 -72 259 0 410 4 428 11 78 29 112 98 113 224 0 186 -45 244 -195 255 l-80 5 -3 143 -3 142 1096 0 1096 0 -3 -142 -3 -143 -75 -5 c-148 -10 -195 -77 -188 -265 3 -92 6 -106 31 -144 53 -80 56 -81 504 -81 254 0 402 4 420 11 80 30 113 97 113 234 0 179 -56 245 -206 245 l-64 0 0 145 0 146 453 -3 c622 -4 580 24 638 -438 16 -135 48 -387 70 -560 22 -173 43 -339 46 -367 l6 -53 66 0 c36 0 127 9 201 20 74 11 161 20 193 20 l57 0 0 86 c0 48 -16 204 -35 348 -20 143 -49 362 -66 486 -72 533 -76 553 -108 625 -75 164 -208 276 -382 321 -55 14 -137 17 -599 18 l-535 1 -6 570 c-5 470 -9 588 -23 673 -110 662 -573 1160 -1216 1307 -105 24 -527 30 -655 10z m385 -520 c463 -70 827 -431 952 -945 20 -79 21 -121 25 -586 l4 -501 -23 -7 c-13 -3 -506 -6 -1096 -6 l-1