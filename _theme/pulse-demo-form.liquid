{%- doc -%}
  Pulse "Live Demo" booking pop-up. Opens from any element with [data-pulse-demo].
  Sends the booking to the Pulse Lead Desk (CRM) as a "Demo request" lead and thanks the customer.

  @param {object} product - The product being viewed.
  @param {string} [whatsapp] - WhatsApp number with country code, no + or spaces.
{%- enddoc -%}
{%- liquid
  assign pdm_wa = whatsapp | default: '919071101108'
  assign pdm_model = product.metafields.pulse.model_name.value
  assign pdm_name = product.title
  if pdm_model != blank
    assign pdm_name = product.title | append: ' (' | append: pdm_model | append: ')'
  endif
-%}
<style>
  .pdm{position:fixed;inset:0;z-index:2147483000;display:none;align-items:center;justify-content:center;padding:16px;background:rgba(15,30,54,.55);backdrop-filter:blur(3px);}
  .pdm.is-open{display:flex;}
  .pdm__box{position:relative;width:min(440px,100%);max-height:calc(100vh - 32px);overflow:auto;background:#fff;border-radius:22px;padding:26px 24px 22px;box-shadow:0 30px 80px -30px rgba(15,30,54,.6);font-family:inherit;color:#0F1E36;}
  .pdm__x{position:absolute;top:12px;right:12px;width:36px;height:36px;border-radius:50%;border:1px solid #E3E8F0;background:#fff;font-size:20px;line-height:1;cursor:pointer;color:#3B4A62;}
  .pdm__head{display:flex;gap:12px;align-items:center;margin:0 36px 6px 0;}
  .pdm__ico{flex-shrink:0;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#E9FBF0;color:#128C4B;}
  .pdm__ico svg{width:24px;height:24px;}
  .pdm h3{margin:0;font-size:20px;line-height:1.2;font-weight:700;}
  .pdm__sub{margin:0 0 16px;font-size:13.5px;color:#5B6B82;line-height:1.45;}
  .pdm__sub b{color:#0F1E36;}
  .pdm label{display:block;font-size:12.5px;font-weight:700;color:#3B4A62;margin:0 0 6px;}
  .pdm input,.pdm select{width:100%;box-sizing:border-box;height:46px;border:1px solid #D6DDE8;border-radius:12px;padding:0 14px;font:inherit;font-size:15px;color:#0F1E36;background:#F7F9FC;}
  .pdm input:focus,.pdm select:focus{outline:2px solid #F2921F;outline-offset:1px;background:#fff;}
  .pdm__f{margin:0 0 12px;}
  .pdm__row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .pdm__ph{display:flex;align-items:center;border:1px solid #D6DDE8;border-radius:12px;background:#F7F9FC;overflow:hidden;}
  .pdm__ph span{padding:0 4px 0 14px;font-size:15px;color:#3B4A62;}
  .pdm__ph input{border:0;background:transparent;padding-left:6px;}
  .pdm__ph input:focus{outline:none;}
  .pdm__ph:focus-within{outline:2px solid #F2921F;outline-offset:1px;background:#fff;}
  .pdm__day{font-size:12.5px;color:#128C4B;font-weight:700;min-height:16px;margin-top:5px;}
  .pdm__err{display:none;margin:0 0 10px;padding:10px 12px;border-radius:10px;background:#FDECEC;color:#B42318;font-size:13px;}
  .pdm__btn{width:100%;height:50px;border:0;border-radius:14px;background:linear-gradient(180deg,#F7A640 0%,#F2921F 100%);color:#0F1E36;font:inherit;font-size:16px;font-weight:700;cursor:pointer;margin-top:4px;}
  .pdm__btn[disabled]{opacity:.6;cursor:wait;}
  .pdm__note{margin:10px 0 0;font-size:12px;color:#7A889C;text-align:center;}
  .pdm__done{display:none;text-align:center;padding:6px 0 2px;}
  .pdm__done .pdm__ico{margin:0 auto 12px;width:56px;height:56px;}
  .pdm__done p{margin:6px 0 16px;color:#3B4A62;font-size:14.5px;line-height:1.5;}
  .pdm__ok{width:100%;height:48px;border:0;border-radius:14px;background:#1B3157;color:#fff;font:inherit;font-size:15px;font-weight:700;cursor:pointer;}
  .pdm__ico--ok{background:#E9FBF0;color:#128C4B;}
  .pdm.is-done form,.pdm.is-done .pdm__sub,.pdm.is-done .pdm__head{display:none;}
  .pdm.is-done .pdm__done{display:block;}
</style>

<div class="pdm" id="pulseDemo" role="dialog" aria-modal="true" aria-labelledby="pdmTitle" hidden>
  <div class="pdm__box">
    <button type="button" class="pdm__x" data-pdm-close aria-label="Close">×</button>
    <div class="pdm__head">
      <span class="pdm__ico">{% render 'pulse-wa-icon' %}</span>
      <h3 id="pdmTitle">Book a free live demo</h3>
    </div>
    <p class="pdm__sub">See the <b>{{ pdm_name | escape }}</b> in action with a free live demo. Pick a time and our mobility expert will contact you to confirm it.</p>
    <form novalidate>
      <div class="pdm__err" role="alert"></div>
      <div class="pdm__f">
        <label for="pdmName">Your name</label>
        <input id="pdmName" name="name" autocomplete="name" required maxlength="80" value="{{ customer.name | escape }}">
      </div>
      <div class="pdm__f">
        <label for="pdmPhone">WhatsApp number</label>
        <div class="pdm__ph"><span>+91</span><input id="pdmPhone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" required maxlength="14" placeholder="10-digit mobile number" value="{{ customer.phone | remove: '+91' | escape }}"></div>
      </div>
      <div class="pdm__row pdm__f">
        <div>
          <label for="pdmDate">Date</label>
          <input id="pdmDate" name="date" type="date" required>
          <div class="pdm__day" id="pdmDay"></div>
        </div>
        <div>
          <label for="pdmTime">Time</label>
          <select id="pdmTime" name="time" required>
            <option value="">Choose a time</option>
            <option>10:00 AM</option><option>11:00 AM</option><option>12:00 PM</option><option>1:00 PM</option>
            <option>2:00 PM</option><option>3:00 PM</option><option>4:00 PM</option><option>5:00 PM</option>
            <option>6:00 PM</option><option>7:00 PM</option>
          </select>
        </div>
      </div>
      <button type="submit" class="pdm__btn">Book my demo</button>
      <p class="pdm__note">Free, no obligation. Monday to Saturday, 10 am – 7 pm.</p>
    </form>
    <div class="pdm__done">
      <span class="pdm__ico pdm__ico--ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
      <h3>Thank you!</h3>
      <p id="pdmDoneText">Our expert will contact you shortly to confirm your demo.</p>
      <button type="button" class="pdm__ok" data-pdm-close>Done</button>
    </div>
  </div>
</div>

<script>
  (function () {
    var box = document.getElementById('pulseDemo'); if (!box || box.dataset.ready) return; box.dataset.ready = '1';
    document.body.appendChild(box);
    var URL = 'https://kpvtevdlmkjngqxdgmlw.supabase.co/functions/v1/store-track';
    var WA = {{ pdm_wa | json }}, PRODUCT = {{ pdm_name | json }}, CID = {{ customer.id | default: '' | json }};
    var f = box.querySelector('form'), err = box.querySelector('.pdm__err'), btn = box.querySelector('.pdm__btn');
    var dEl = document.getElementById('pdmDate'), dayEl = document.getElementById('pdmDay');
    var DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    function ymd(d) { return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }
    function parse(v) { var p = (v || '').split('-'); return p.length === 3 ? new Date(+p[0], +p[1] - 1, +p[2]) : null; }
    var today = new Date(), max = new Date(); max.setDate(max.getDate() + 60);
    dEl.min = ymd(today); dEl.max = ymd(max);
    function dayName() { var d = parse(dEl.value); dayEl.textContent = d ? DAYS[d.getDay()] : ''; return d ? DAYS[d.getDay()] : ''; }
    dEl.addEventListener('change', dayName); dEl.addEventListener('input', dayName);
    function vid() {
      var k = 'pulse_demo_vid', v = null;
      try { v = localStorage.getItem(k); } catch (e) {}
      if (!v) { v = 'demo' + Math.random().toString(36).slice(2) + Date.now().toString(36); try { localStorage.setItem(k, v); } catch (e) {} }
      return v;
    }
    function open(e) {
      if (e) e.preventDefault();
      box.hidden = false; box.classList.add('is-open'); box.classList.remove('is-done'); err.style.display = 'none';
      document.documentElement.style.overflow = 'hidden';
      setTimeout(function () { (document.getElementById('pdmName').value ? document.getElementById('pdmPhone') : document.getElementById('pdmName')).focus(); }, 50);
    }
    function close() { box.classList.remove('is-open'); box.hidden = true; document.documentElement.style.overflow = ''; }
    document.addEventListener('click', function (e) {
      var t = e.target.closest && e.target.closest('[data-pulse-demo]');
      if (t) open(e);
      else if (e.target === box || (e.target.closest && e.target.closest('[data-pdm-close]'))) close();
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && box.classList.contains('is-open')) close(); });
    function fail(m) { err.textContent = m; err.style.display = 'block'; }
    f.addEventListener('submit', function (e) {
      e.preventDefault(); err.style.display = 'none';
      var name = document.getElementById('pdmName').value.trim(), ph = document.getElementById('pdmPhone').value.replace(/\D/g, '').replace(/^(91|0)(?=\d{10}$)/, ''), date = dEl.value, time = document.getElementById('pdmTime').value, day = dayName();
      if (name.length < 2) return fail('Please enter your name.');
      if (!/^[6-9]\d{9}$/.test(ph)) return fail('Please enter a valid 10-digit WhatsApp number.');
      var d = parse(date); if (!d || date < dEl.min || date > dEl.max) return fail('Please choose a date in the next 60 days.');
      if (!time) return fail('Please choose a time.');
      var nice = d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
      var fields = [
        { n: 'form_type', t: 'hidden', v: 'contact' },
        { n: 'contact[tags]', t: 'hidden', v: 'demo, live demo' },
        { n: 'contact[form]', t: 'hidden', v: 'Live demo' },
        { n: 'contact[name]', t: 'text', v: name },
        { n: 'contact[phone]', t: 'tel', v: '+91' + ph },
        { n: 'contact[Wheelchair]', t: 'text', v: PRODUCT },
        { n: 'contact[Demo date]', t: 'text', v: nice },
        { n: 'contact[Demo day]', t: 'text', v: day },
        { n: 'contact[Demo time]', t: 'text', v: time }
      ];
      var body = JSON.stringify({ k: 'form', c: CID ? String(CID) : '', v: vid(), p: location.pathname, d: /Mobi|Android/i.test(navigator.userAgent) ? 'mobile' : 'desktop', f: fields });
      btn.disabled = true; btn.textContent = 'Booking…';
      var done = function () {
        btn.disabled = false; btn.textContent = 'Book my demo';
        document.getElementById('pdmDoneText').textContent = 'Thanks ' + name.split(' ')[0] + '! Our expert will contact you shortly to confirm your demo of the ' + PRODUCT + ' on ' + day + ', ' + nice + ' at ' + time + '.';
        box.classList.add('is-done');
      };
      fetch(URL, { method: 'POST', body: body, mode: 'no-cors', keepalive: true }).then(done, function () {
        btn.disabled = false; btn.textContent = 'Book my demo';
        fail('Could not send right now. Please try again, or call us on +91 90711 01108.');
      });
    });
  })();
</script>
